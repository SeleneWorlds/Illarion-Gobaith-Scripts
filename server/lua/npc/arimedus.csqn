use: german -> "Ich würde es bevorzugen, wenn ihr mich nicht anfasst!"
use: english -> "Ich would prefer, that you don't touch me!!"

cycle: pick(
    if(german, "#me nimmt eine andere Schriftrolle vom Stapel. ", "#me takes another scoll from the stack."),
    if(german, "#me hebt kurz den Kopf an und blickt über den Rand seiner Brille durch den Raum.", "#me raises his head slightly and looks over the edge of his glassen through the room."),
)

chat: match("[gg]rüß") -> "Elara zum Gruße. Kann ich euch behilflich sein?"

chat: match("[hh]allo") -> "Scht! Dies ist eine Bücherei, keine Taverne."

chat: match("[gg]reetings") -> "Greetings. Can I help you?"

chat: match("[hh]ello") -> "Hush! This is a library, not a tavern."

chat: match("[kk]auf") -> "Es tut mir leid, aber ich brauche grade nichts."

chat: match("[vv]erkauf") -> "Es tut mir leid, aber ich habe nichts zu verkaufen."

chat: match("[bb]uy") -> "I'm sorry, but I don't need anything at the moment."

chat: match("[ss]ell") -> "I'm sorry, but I have nothing to sell."

chat: match("[hh]ilfe") -> "Ihr braucht hilfe? Wobei? Ich kann euch etwas über die Bedeutung von Runen erzählen, wenn ihr mögt."

chat: match("[hh]elp") -> "You need help? For what? I can tell you something about the meaning of the runes, if you like."

chat: match("[dd]u") -> "Ich möchte euch bitten mich nicht so unformell anzusprechen."

chat: match("[dd]ein") -> "Ich möchte euch bitten mich nicht so unformell anzusprechen."

chat: match("[dd]ir") -> "Ich möchte euch bitten mich nicht so unformell anzusprechen."

chat: match("[dd]ich") -> "Ich möchte euch bitten mich nicht so unformell anzusprechen."

chat: match("[ee]ntschuld") -> "Schon in Ordnung. Kann ich euch irgendwie weiterhelfen?"

chat: match("i.+am") -> "It's a pleasure to meet you."

chat: match("i'm") -> "It's a pleasure to meet you."

chat: match("[mm]y.+name") -> "It's a pleasure to meet you."

chat: match("ich.+bin") -> "Es freut mich euch kennenzulernen."

chat: match("[mm]ein.+name") -> "Es freut mich euch kennenzulernen."

chat: match("[ww]er.+seid") -> "Mein Name ist %NPCNAME"

chat: match("[ee]uer.+name") -> "Mein Name ist %NPCNAME"

chat: match("[yy]our.+name") -> "My name is %NPCNAME"

chat: match("[ii]hr.+hier") -> "Wie ihr sicher seht, arbeite ich an einigen schriftlichen Ausarbeitungen."

chat: match("[yy]ou.+here") -> "You see, I work on some papers."

chat: match("[aa]usarbeitung") -> "Ich arbeite an einer Zusammenfassung der Bedeutung aller Runen."

chat: match("[pp]aper") -> "I write on a elaboration about the meaning of all runes."

chat: match("[ii]nteressant") -> "Ja, das ist es in der Tat."

chat: match("[ii]nteresting") -> "Indeed."

chat: match("[dd]arüber.+erzählen") -> "Sicher kann ich das, von welcher Rune möchtet ihr die Bedeutung wissen?"

chat: match("[dd]arüber.+erzählen") -> "Of course. About which rune you like to hear the meaning?"

chat: german, match("[rr]une") -> "Von welcher Rune möchtet ihr die Bedeutung wissen?"

chat: english, match("[rr]une") -> "About which rune you like to hear the meaning?"

chat: german, match("[bb]edeutung") -> "Von welcher Rune möchtet ihr die Bedeutung wissen?"

chat: english, match("[mm]eaning") -> "About which rune you like to hear the meaning?"

chat: english, match("ra") -> "RA is the rune of fire and a elemental rune. It can be used for offensive firespells and explosions, create and put out fireflames."

chat: german, match("ra") -> "RA ist die Rune des Feuers und eine Elementarrune. Sie kann für offensive Feuerzauber genutzt werden, sowie zum Entfachen und Auslöschen von Feuerflammen."

chat: english, match("hept") -> "HEPT is the rune of ice. It can be used for offensive icespells and icebolts, create and put out iceflames."

chat: german, match("hept") -> "HEPT ist die Rune des Eises. Sie kann für offensive Eiszauber genutzt werden, sowie zum Entfachen und Auslöschen von Eisflammen."

chat: english, match("pen") -> "PEN is the rune of spirit and a elemental rune. It can be used to cast healing spells, both weak, strong, and over an area."

chat: german, match("pen") -> "PEN ist die Rune des des Geistes und eine Elementarrune. Sie kann für starke und schwache Heilzauber benutzt werden."

chat: english, match("mes") -> "MES is the rune of light. It can be used to cast healing spells, both weak, strong, and over an area."

chat: german, match("mes") -> "MES ist die Rune des Lichts. Sie kann für starke und schwache Heilzauber benutzt werden."

chat: english, match("orl") -> "ORL is the rune of creating and materialisation. It can be used to create walls, relieve hunger and created thunderstorms. "

chat: german, match("orl") -> "ORL ist die Rune der Materialisierung. Sie kann genutzt werden um Steinwände zu erschaffen, Hunger zu stillen und Gewitterstürme heraufzubeschwören."

chat: english, match("cun") -> "CUN is the rune of water and a elemental rune. It can be used to put out campfires. "

chat: german, match("cun") -> "CUN ist die Rune des Wassers und eine Elementarrune. Sie kann benutzt werden um Lagerfeuer auszulöschen."

chat: english, match("sav") -> "SAV is the rune of protection. It can be used to create flames and walls around you, which can protect you."

chat: german, match("sav") -> "SAV ist die Rune des Schutzes. Sie kann benutzt werden um Flammen und Steinwälle um dich herum entstehen zu lassen, die dich schützen."

chat: english, match("solh") -> "SOLH is the rune of earth and a elemental rune. It can be used in paralysis, storms and wall creation. "

chat: german, match("solh") -> "MES ist die Rune der Erde und eine Elementarrune. Sie kann genutzt werden um Steinwände zu erschaffen, Stürme heraufzubeschwören und den Gegner zu paralysieren."

chat: english, match("fhen") -> "FHEN is the rune of fetching. It can be used to bring small and large objects towards you. Some say it has another use... "

chat: german, match("fhen") -> "FHEN steht als Rune für das Holen. Sie kann benutzt werden, um kleine und größere Objekte zu dir zu holen. Es gibt jedoch Gerüchte, es gäbe noch eine andere Verwendung für sie..."

chat: english, match("kah") -> "KAH is the rune of nourishment and food. It can be used to relieve hunger, both minorly and thoroughly. "

chat: german, match("kah") -> "KAH ist die Rune der Nahrung und Ernährung. Sie kann sie benutzen um sich selbst leicht, oder auch ausreichend zu sättigen."

chat: english, match("lhor") -> "LHOR is the rune of illusion. It can be used to create illusionary objects like fireballs, flames, iceballs, ice flames and such things. "

chat: german, match("lhor") -> "LHOR ist die Rune der Illusion. Sie kann benutzt werden um illusionäre Objekte zu erschaffen, wie Feuerbälle, Feuerflammen, Eisbälle und solche Dinge."

chat: english, match("kel") -> "KEL is the rune of moving. It can be used to cast motion-related spells and has many uses. For instance, fireballs, iceballs, bringing things to you, remedying paralysis and operating doors. "

chat: german, match("kel") -> "KEL ist die Rune der Bewegung. Sie kann genutzt werden für bewegungsgebundene Zauber wie zum Beispiel Feuerbälle, Eisbälle und Teleportation"

chat: english, match("tah") -> "TAH is the rune of inverse. It can be used to remove things, such as walls, flames, iceflames, portals, poison clouds and illusions. "

chat: german, match("tah") -> "TAH ist die Rune der Umkehrung. Sie kann genutzt um erschaffene Dinge wieder aufzulösen, zum Beispiel Flammen, Portale, Giftwolken und Illusionen."

chat: english, match("taur") -> "TAUR is the rune of creatures. It can be used in summoning and teleportation. "

chat: german, match("taur") -> "Die Rune TAUR steht für alle Kreaturen. Sie kann bei der Teleportation genutt werden und bei der Beschwörung von Wesenheiten."

chat: english, match("ura") -> "URA is the rune of nature. It can be used to summon natural creatures."

chat: german, match("ura") -> "URA ist die Rune des Natürlichen. Sie kann benutzt werden um natürliche Kreaturen herbeizubeschwören."

chat: english, match("ira") -> "IRA is the rune of unnaturality. It can be used to summon unnatural creatures and also to create flames, iceflames and poison clouds. "

chat: german, match("ira") -> "IRA ist die Rune des Unnatürlichen. Sie wird benutzt um unnatürliche Kreaturen herbeizubeschwören, aber auch um Flammen und Giftwolken zu beschwören."

chat: english, match("yeg") -> "YEG is the rune of poison. It can be used to cast offensive poison spells, create and put out poison clouds, as well as curing poison. "

chat: german, match("yeg") -> "YEG ist die Rune des Giftes. Sie wird für offensive Giftsprüche benutzt, um Giftwolken zu erschaffen oder auszulöschen aber auch um Vergiftungen zu heilen"

chat: english, match("jus") -> "JUS is the rune of wind and a elemental rune. It can be used for offensive and defensive wind-spells, to bring objects towards you, teleportation, as well as remedying paralysis."

chat: german, match("jus") -> "JUS ist die Rune des Windes und eine Elementarrune. Sie wird genutzt für defensive und offensive Windsprüche, um Objekte zu bewegen, für die Teleportation und um zu Paralysieren."

chat: english, match("sih") -> "SIH is the rune of healing. It can be used in strong healing spells and to heal poison. "

chat: german, match("sih") -> "SIH die Rune der Heilung. Sie wird für starke Heilzauber genutzt und um Vergiftungen zu heilen."

chat: english, match("anth") -> "ANTH is the rune of objects. It can be used to summon flames, iceflames, poison clouds, to operate doors and to bring objects towards you. "

chat: german, match("anth") -> "ANTH ist die Rune des Objekts. Sie wird benutzt um Flammen und Giftwolken zu beschwören, um Türen zu öffnen und Objekte zu bewegen."

chat: english, match("sul") -> "SUL is the rune of standing and slowness. It can be used to paralyse people for a short time. "

chat: german, match("sul") -> "SUL ist die Rune der Unbeweglichkeit. Sie wird genutzt um Personen für eine kurze Dauer zu paralysieren."

chat: english, match("qwan") -> "QWAN is the rune of strength. It can be used to step up spells and make them more effective. "

chat: german, match("qwan") -> "QWAN ist die Rune der Stärke. Sie wurd benutzt um Sprüche zu verstärken und macht sie so wirkungsvoller."

chat: english, match("dun") -> "DUN is the rune of area. It can be used to create areas of things. "

chat: german, match("dun") -> "DUN ist die Rune der Fläche. Sie wird benutzt um den Effekt von anderen Sprüchen auszuweiten."

chat: english, match("pherc") -> "PHERC is the rune of harm. It can be used to create lightning and for effective poison people. "

chat: german, match("pherc") -> "PHERC ist die Rune der Verletzung. Sie wird genutzt um Blitze herbeizubeschwören und um effektiv jemanden zu vergiften."

chat: english, match("fhan") -> "FHAN is the rune of sending. FHAN is a mysterios Rune. I haven't found any spell for this rune, but maybe you found one...."

chat: german, match("fhan") -> "FHAN ist die Rune des Bringens. FHEN ist eine sehr mysteriöse Rune, ich habe bisher noch keine Anwendung dafür gefunden, aber vielleicht findet ihr ja eine..."

chat: english, match("luk") -> "LUK is the rune of evil. It is used to summon hostile creatures. "

chat: german, match("luk") -> "LUK ist die Rune des Böse. Sie kann benutzt werden um aggresive Kreaturen herbeizubeschwören."

chat: english, match("lev") -> "LEV is the rune of change. I know a few people who are able to cast teleport-spells into a scroll with this rune, but I heard that this is very difficult. "

chat: german, match("lev") -> "LEV ist die Rune der Veränderung. Ich habe von ein paar Personen gehört, die fähig sein sollen Teleportsprüche damit in Schriftrollen zu bannen, aber es soll sehr schwer sein."

chat: english, match("bhona") -> "BHONA is the rune of teaching. It is used to teach another person runes. Only teachers can get this rune. "

chat: german, match("bhona") -> "BHONA ist die Rune des Lehrens. Sie wird benutzt um anderen Personen Runen zu lehren. Nur Lehrer können diese Rune bekommen."
