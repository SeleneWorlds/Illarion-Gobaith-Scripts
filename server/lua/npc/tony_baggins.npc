"[gg]reetings", "[hh]ello" -> "Hiho. How can I help you?", "Hello. Do you need something? I'm an alchemist and sell dyes of all colors. All are selfmade!"
"[gg]rü[ßs]+e", "[hh]allo" -> "Hiho! Wie kann ich dir helfen? Ich habe allerhand Farben. Alle selbst gemacht!", "Hallo. Wer bist du denn?"
"[yy]ou.+[tt]rader" -> "Yes, i trade with dyes and ingredients to make them."
"[ddii][uh]r*.+[hh][äa]ndler" -> "Ja, ich handle mit Farben und Zutaten zur Herstellung von Farben."
"[yy]ou.+[hh]ealer" -> "No, i am not. I am an alchemist and sell dyes"
"[ddii][uh]r*.+[hh]eiler" -> "Nein bin ich nicht. Ich bin Alchemist und verkaufe Farben."
"[ww]hat.+sell" -> "Do you want that i list my wares? Here take a look at the best dyes you can find!"
"[ww]as.+verkauf" -> "Willst du eine Liste meiner Waren sehen? Hier, schau. Das sind die besten Farben die du finden wirst"
"[ww]hat.+[ww]ares" -> "I trade with dyes and ingredients to make them."
"[ww]as.+[ww]aren" -> "Ich handele mit Farben und Zutaten zu deren Herstellung."
"[ww]hat.+[pp]otion" -> "I have no potions anymore. I only trade with dyes and ingredients to make them."
"[ww]as.+[tt]ränke" -> "Ich habe keine Tränke mehr. Ich handele nur noch mit Farben und Zutaten zu deren Herstellung."
"[ww]hat.+[cc]loth" -> "I don't trade with cloth anymore. The business with cloths didn't work."
"[ww]as.+[kk]leidung" -> "Ich habe keine Kleidung mehr im Angebot. Das Geschäft mit den abgetragenen Klamotten lief nicht gut."
"[ww]hat.+[mm]ore" -> "I need different tools and goods to make dyes"
"[ww]as.+[mm]ehr" -> "Ich brauche verschiedene Werkzeuge und Sachen um Farben herzustellen."
"[ww]hat.+[dd]ye" -> "I'm an alchemist and prepare different dyes. You are interested in red, blue, yellow or other?"
"[ww]as.+[ff]arbe" -> "Ja, ich bin Alchemist und verkaufe verschiedene Farben. Bist du vielleicht an Rot oder Blau interessiert? Was anderes?"
"[gg]oodbye", "[bb]ye", "[ff]arewell" -> "Have a nice day. Oldra may bless you.", "Farewell!", "Good day."
"[aa]uf.+[bb]ald", "[bb]is.+[bb]ald" -> "Schönen Tag noch! Oldra segne euch!", "Schönen Tag!"
"[ww]ho.+you?" -> "My name is Tony Baggins. I am an alchemist and I work here. But I come from Greenbriar. Do you know my home village?"
"[ww]er.+[ddii][uh]r*" -> "Ich bin Tony Baggins. Ich bin Alchemist und arbeite hier. Aber ich komme von Greenbriar. Kennst du mein Heimatdorf?"
"i'm.+.+" -> "Nice to meet you. Do you need my help?"
"[ii]ch.+[bb]in" -> "Freut mich! Kann ich dir helfen?"
"[hh]elp" -> "'List your wares', 'I want to buy <number> <wares>', 'I want to buy a <ware>', 'I want to sell <number|a> <wares>', 'Price of ...','What do you pay for ...', 'What wares do you buy?', 'Tell <something>'"
"[hh]ilfe" -> "'Welche Waren verkauft ihr', 'Ich möchte <Anzahl> <Ware> kaufen', 'Ich möchte <Ware> kaufen', 'Ich möchte <Anzahl> <Ware> verkaufen', 'Was ist der Preis von <Ware>','Was zahlt ihr für <Ware>', 'Was kauft ihr?', 'Erzähl über <etwas>'"

-- Open the trading menu.
"trade", "buy", "sell", "wares", "handel", "kauf", "verkauf", "waren" -> trade
