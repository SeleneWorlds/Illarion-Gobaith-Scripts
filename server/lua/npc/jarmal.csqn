use: german -> "Finger weg!"
use: english -> "Don't you touch me!"

chat: match(
    "[hh]ello",
    "[gg]reetings",
) -> pick(
    "Greetings Traveler, I hope you had a pleasant voyage.",
    "Ah, Greetings Landrat. Was the journey rough?",
)

chat: match(
    "[hh]allo",
    "[gg]r[uü][sß]+",
) -> pick(
    "Grüße Reisender, ich hoff du hattest ne angenehme Reise.",
    "Ah, Grüße Landratte. War die Reise rau?",
)

chat: match("[ww]ho") -> "I am Jarmal, shipboy."

chat: match("[ww]er") -> "Ich bin Jarmal, Schiffsjunge."

chat: match("[ww]here.+a[mr]e*") -> "This is the harbour, where else did you expect a ship to bring you?"

chat: match("[ww]o.+[sb]ind*") -> "Das ist der Hafen. Wo sonst dachtest du brinst dich 'n Schiff hin?"

chat: match("[hh]arbour") -> "Not as big as one would expect, right? But it does the job still."

chat: match("[hh]afen") -> "Nicht so groß wie du dachtest, richtig? Aber er dient seinem Zweck."

chat: match("[tt]own") -> "The next big Town is Trollsbane, to the northeast. Or the village Greenbriar to the west."

chat: match("[ss]t[aä]dt") -> "Die nächste große Stadt ist Trollsbane im Nordosten. Oder das Dorf Greenbriar im Westen."

chat: match("[ww]hat.+sell") -> "I aint selling anything, landrat."

chat: match("[ww]as.+verkauf") -> "I verkauf nix, Landratte."

chat: match("[ww]hat.+buy") -> "Do I look like some filthy rich trader, landrat?"

chat: match("[ww]as.+%skauf") -> "Seh ich aus wie'n reicher Händler, Landratte?"

chat: match("[hh]elp") -> "Best advice I can give you, go somewhere else."

chat: match("[hh]ilfe") -> "Der beste Tipp, den ich dir geben kann, ist woanders hin zu gehen"

chat: match("[ss]somewhere.+else") -> "Like Trollsbane, or Greenbriar."

chat: match("[aa]nders") -> "Wie Trolls Bane oder Greenbriar."

chat: match("[nn]ew.+here") -> "I thought so the first time I saw you. Well, welcome on this little godforsaken island, landrat."

chat: match("[nn]eu.+hier") -> "Das wusst ich schon als ich dich das erste Mal gesehen hab. Naja...willkommen auf dieser kleinen Insel, Landratte."

chat: match("[ii]sland") -> "Yes, welcome on the island of ... of ... arr, forget it. Have some ale with you?"

chat: match("[ii]nsel") -> "Ja. Willkommen auf der Insel...ähm...arr, ich habs vergessen. Hast du Bier dabei?"

chat: match("[tt]roll'*s.*[bb]ane") -> if(german, "Aye, Trollsbane im Nordosten. Du kannst eigentlich alles doch finden.", "Aye, Trollsbane in the Northeast. You can find practicly everything there.")

chat: match("[gg]reen.*[bb]riar") -> if(german, "Früher war es mal ein Halblingsdorf, jetzt sollen dort aber nur noch Elfen leben.", "This used to be a Halfling village, now only some elves live here.")

chat: match(
    "[bb]ye.",
    "[ff]arewell",
) -> pick(
    "Aye, Landrat.",
    "Aye aye.",
)

chat: match(
    "[aa]uf.+[bb]ald",
    "[bb]is.+[bb]ald",
) -> pick(
    "Aye, Landratte",
    "Aye aye",
)
