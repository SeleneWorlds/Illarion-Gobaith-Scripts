-- Derived from old/irmtrud.lua; UTF-8.
-- Archived Lua remains the reference for custom behavior.
name = "Irmtrud"
race = dwarf
sex = female
position = 136, -161, -9
direction = south
radius = 0
language = common
language = dwarf
defaultLanguage = common
autointroduce = on
useMsgDE = "Finger wech oder du bist ein Kopf kürzer!"
useMsgUS = "Dont ya' touch me!"


lua("npc.custom.dwarf_gate", "isCommand", "irmtrud"), ".+" -> lua("npc.custom.dwarf_gate", "operate", "irmtrud")
"[gg]rü[sß]", "[hh]allo", "[gg]rue[sß]", "[tt]a[gc].*" -> "Tach du.", "Grüß dich!"
"[aa]uf.+[bb]ald", "[gg]ötter.+euch", "[bb]is.+[bb]ald", "[uu]ff.+[bb]ald", "[ff]ünf.+euch" -> "Auf bald. Irmorom mit dir."
"[ww]er.+[bs][ie][si][td].+[di][uh].*", "[ww]ie.+[nn]ame" -> "Ick bin die %NPCNAME von der Bürgerwehr Silberbrands, jau! Ick bewache die Tore."
"[hh]ilfe" -> "Ick schätze ick kann dir nich' viel helfen, hab hier Wache zu halten. Frach am besten nen anderen Zwerchen nach Hilfe."
"[gg]reeting", "[hh]ello" -> "Be greeted!", "Greetings"
"[gg]oodbye", "[bb]ye", "[ff]arewell", "[ff]ive.+you" -> "Farewell. Irmorom with you.", "Goodbye"
"[ww]ho.+you", "[ww]hat.+[nn]ame" -> "I am %NPCNAME, from the Militia of Silverbrand, aye! I guard the gates."
"[hh]elp" -> " I don't think that I can help ya much, I have to keep watching here. The best is if ya' ask another dwarf for help."
"buy" -> "I don't sell anything. Do I look like a merchant?"
"sell" -> "Thanks, but I already have everything I need."
"[ww]hat.+buy" -> "Thanks, but I already have everything I need."
"[ww]hat.+sell" -> "I don't sell anything. Do I look like a merchant?"
"[kk]aufen" -> "Ick verkauf nichts. Sehe ich etwa aus wie ein Händler ?"
"[vv]erkaufen" -> "Danke nein, ich habe bereits alles, wat ick brauche."
"[ww]as.+kaufst" -> "Danke nein, ich habe bereits alles, wat ick brauche."
"[ww]as.+verkaufst" -> "Ick verkauf nichts. Sehe ich etwa aus wie ein Händler?"
english, "[gg]obaith" -> "This whole island group is called Gobiath. Nice place, the weather usually does not get too rough or too hot, I like it."
english, "[gg]reenbriar" -> "Greenbriar is a settlement of the Halflings."
"[hh]arbo[u]+r" -> "Troll's Bane and Vanima both have Harbors. The one southwest from Troll's Bane is bigger though."
english, "[hh]ellbriar" -> "That was an evil dungeon near Greenbriar ! The evil Cultists there sacrificed most of the Halflings of Greenbriar."
"[mm]agic.+[aa]cademy" -> "You don't want to go THERE ! It can only be reached by a mage, they say. They turn people into pigs or cows or worse things there!"
"[mm]age.+[aa]cademy" -> "You don't want to go THERE ! It can only be reached by a mage, they say. They turn people into pigs or cows or worse things there!"
"[nn]orthmark" -> "it's not cooler there than elsewhere on Gobiath, except for the north wind in winter. Some Norodaj-Barbarians have settled there."
"[ss]ilverbrand" -> "Silverbrand is the name of this town, its the town of the dwarfes."
english, "[vv]anima" -> "Tol Vanima ? That's a whole small island full of trees and elves."
english, "[tt]roll['s].+[bb]ane" -> "Well, that's the biggest town on Gobiath."
english, "[vv]arshikar" -> "You find it past the small sand desert in the far northwest. I would use the Teleporter, the desert is full of scorpions."
german, "[gg]obiath" -> "Diese ganze Inselgruppe wird Gobiath genannt. Nette Gegend, dat Wetter wird nich zu rauh oder zu heiß, ick mag es."
german, "[gg]reenbriar" -> "Greenbriar is ne Halblingssiedlung."
"[hh]afen" -> "Troll's Bane und Vanima haben Häfen. Der Hafen südwestlich von Troll's Bane ist aber größer."
german, "[hh]ellbriar" -> "Das war ein von einem barbarischen Kult besetzter Dungeon nahe bei Greenbriar. Die bösartigen Kultisten dort haben die meisten der Halblinge geopfert."
"[mm]agierakademie" -> "Ihr wollt nicht wirklich DA hin ! Es wird gesagt, den Ort kann nur ein Magier erreichen. Die verwandeln dort Leute in Schweine, Kühe oder schlimmeres !"
"[nn]ordmark" -> "Es ist da nicht kälter als anderswo auf Gobiath, abgesehen vom Nordwind im Winter. Dort haben sich einige Norodaj-Barbaren angesiedelt."
"[ss]ilberbrand" -> "Silberbrand ist der Name dieser Stadt hier, es ist die Stadt der Zwerge."
german, "[vv]anima" -> "Tol Vanima ? Das ist eine ganze kleine Insel voller Bäume und Elfen."
german, "[tt]roll['s].+[bb]ane" -> "Tja, das ist die grösste Stadt auf Gobiath."
german, "[vv]arshikar" -> "Das findet man weit im Nordwesten hinter der kleinen Sandwüste. Ich würde den Teleporter benutzen, die Wüste ist voller Skorpione."
english, "[ii]rmorom" -> "The Lord of trade and craftsmenship ! He is the main god of the dwarves."
german, "[ii]rmorom" -> "Der Herr des Handels und des Handwerks ! Er ist der Hauptgott des Zwergenvolkes."

-- Idle dialogue
cycletext "#me lehnt sich auf ihre Axt und lässt einen prüfenden Blick durch die Mine schweifen.", "#me leans on her axe and looks vetting through the mine."
cycletext "#me geht vor die Tore und rüttelt an ihnen \"Aye, is zu!\"", "#me steps infront of the gate and juggles it \"Aye, it's closed!\""
cycletext "#me zieht eine Flasche Bier aus der Tasche und nimmt einen großzügigen Schluck.", "#me pulls a bottle of beer out of her bag and takes a generous sip."

-- Migration follow-up
-- Legacy commands from up to ten tiles away require a dialogue-range extension.
