"[hh]elp" -> "'List your wares', 'I want to buy <number> <wares>', 'I want to buy a <ware>', 'I want to sell <number|a> <wares>', 'Price of ...','What do you pay for ...', 'What wares do you buy?'"
"[gg]reet", "[hh]ello", "[hh]i" -> "Greetingsss. How i can help you?.", "Aye! You are interested in my wares?"
"[ww]hat.+sell" -> "I sell different tools"
"[ww]hat.+[tt]ool" -> "Whatever you want: scrissors, saws, hammers, shovels, needles, axes, sickles, scythes and glas blow pipes."
"[ww]ho.+[ii]rmorom" -> "Irmorom is the god of the dwarves, of the trade and the craftsmanship"
"[bb]ye", "[ff]arewell" -> "Aye! Irmorom may bless you.", "Farewell. You are welcome to come back and to trade with me."
"[gg]r[uü][sß]+", "[hh]allo" -> "Aye! Was willst du?", "Hallo. Willst du was von meinen Waren kaufen?"
"[ww]as.+kauf" -> "Ja, ich habe Verschiedene Werkzeuge."
"[ww]as.+[ww]erkzeug" -> "Was auch immer dir helfen mag: Scheren, Sägen, Hammer, Schaufeln, Nadeln, Äxte, Sicheln, Sensen und Glasblas Rohre."
"[aa]uf.+[bb]ald", "[bb]is.+[bb]ald" -> "Ja, du kannst gern wieder herkommen, wenn du was brauchst. Irmorom sei mit dir!", "Aye! Kannst gern wieder herkommen, wenn du was brauchst."
"[ww]er.+[ii]rmorom" -> "Irmorom ist der Gott der Zwerge, des Handels und der Handwerker"
"[hh]ilfe" -> "'Welche Waren verkauft ihr', 'Ich möchte <Anzahl> <Ware> kaufen', 'Ich möchte <Ware> kaufen', 'Ich möchte <Anzahl> <Ware> verkaufen', 'Was ist der Preis von <Ware>','Was zahlt ihr für <Ware>', 'Was kauft ihr?'"

-- Open the trading menu.
"trade", "buy", "sell", "wares", "handel", "kauf", "verkauf", "waren" -> trade
