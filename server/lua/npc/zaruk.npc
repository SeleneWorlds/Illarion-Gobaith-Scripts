"[hh]ello", "[gg]reetings" -> "Greetin's.", "Aye! Greetins to ye'."
"[hh]allo", "[gg]rü[ßs]+e" -> "Moin", "Aye. Grüß euch."
"[jj]ob" -> "I'm an importer, and I pull in wares from far and wide. Puts the jingle in me purse."
"[bb]eruf" -> "Ich bin ein Importierer und bekomm Waren von weit, weit weg."
"[ii]mported" -> "Aye, imported wares, from the mainland to right here. See all the ships? Well, it's a quiet day today. Aye?"
"[ii]mportiert" -> "Aye, importiere Waren, vom Festland direkt hier her. Siehst all die Schiffe. Nuja, ist ein ruhiger Tag heute, aye?"
"[ww]ares" -> "I have all sorts of gimcracks that ye'll surely be interested in. You seen my list?"
"[ww]are" -> "Ich hab alle Arten von Zeug die dich garantiert interessieren. Willst meine Warenliste sehen?"
"[ss]hip" -> "Aye! I once sailed across the seas. Hard work. Not enough coin."
"[ss]chiff" -> "Aye! Bin lange zur See gefahren. Harte Arbeit und beschissene Bezahlung."
"[bb]ye", "[ff]arewell" -> "Aye! Farewell there.", "'Ave a pleasant day, there!"
"[aa]uf.+[bb]ald", "[bb]is.+[bb]ald" -> "Aye. Auf bald.", "Aye. Schön Tag noch."
"[hh]elp" -> "'List your wares', 'I want to buy <number> <wares>', 'I want to buy a <ware>', 'I want to sell <number|a> <wares>', 'Price of ...','What do you pay for ...', 'What wares do you buy?'"
"[hh]ilfe" -> "'Welche Waren verkauft ihr', 'Ich möchte <Anzahl> <Ware> kaufen', 'Ich möchte <Ware> kaufen', 'Ich möchte <Anzahl> <Ware> verkaufen', 'Was ist der Preis von <Ware>','Was zahlt ihr für <Ware>', 'Was kauft ihr?'"

-- Open the trading menu.
"trade", "buy", "sell", "wares", "handel", "kauf", "verkauf", "waren" -> trade
