"[gg]reet", "[hh]ello", "[hh]i" -> "Hiho. Who are you?", "Hiho. How can I help you?"
"[hh]allo", "[gg]r[uü][sß]*" -> "Hiho! Wer bist du?", "Hiho! Wie kann ich dir helfen?"
"[yy]ou.+[tt]rader" -> "Yes, I am a trader. What do you want?"
"[ddii][uh]r*.+[hh]ändler" -> "Jap, ich bin Händler. Was brauchst du?"
"[ww]hat.+sell" -> "I sell tools, food and seeds."
"[ww]as.+verkauf" -> "Ich verkauf' Werkzeug, Nahrung und Samen."
"[ww]hat.+[ff]ood" -> "I sell bread and ham. Fish and trout."
"[ww]as.+[nn]ahrung" -> "Ich verkauf' Brot und Schinken. Fische und Forellen"
"[ww]hat.+[ss]eed" -> "I sell grain and cabbage seeds."
"[ww]as.+[ss]amen" -> "Ich verkauf' Getreide und Kohlsamen"
"[ww]hat.+[tt]ool" -> "I have flails, scythe, sickles, fishing rod."
"[ww]as.+[ww]erkzeug" -> "Ich habe Dreschflegel, Sensen, Sicheln und Angeln. Interessiert?"
"[gg]oodbye" -> "Have a good day. You are welcome to come back."
"[aa]uf.+[bb]ald", "[bb]is.+[bb]ald" -> "Schönen Tag noch! Bis bald!", "Bis bald! Ushara mit dir!"
"[bb]ye", "[ff]arewell" -> "Farewell.", "Farewell. Ushara may be with you."
"[ww]ho.+you?" -> "I am %NPCNAME, a farmer."
"[ww]er.+[ddii][uh]r*" -> "Ich bin %NPCNAME, Bauer."
"[hh]elp" -> "'List your wares', 'I want to buy <number> <wares>', 'I want to buy a <ware>', 'I want to sell <number|a> <wares>', 'Price of ...','What do you pay for ...', 'What wares do you buy?'"
"[hh]ilfe" -> "'Welche Waren verkauft ihr', 'Ich möchte <Anzahl> <Ware> kaufen', 'Ich möchte <Ware> kaufen', 'Ich möchte <Anzahl> <Ware> verkaufen', 'Was ist der Preis von <Ware>','Was zahlt ihr für <Ware>', 'Was kauft ihr?'"

-- Open the trading menu.
"trade", "buy", "sell", "wares", "handel", "kauf", "verkauf", "waren" -> trade
