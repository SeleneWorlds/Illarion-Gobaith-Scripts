-- Derived from old/elinadoron.lua; UTF-8.
-- Archived Lua remains the reference for custom behavior.
name = "Elina Doron"
race = human
sex = female
position = -257, -292, 0
direction = south
language = common
language = human
language = lizard
defaultLanguage = common
autointroduce = on
useMsgDE = "Fasst mich nicht an!"
useMsgUS = "Don't you touch me!"
lookatDE = "Eine junge, hübsche Frau, die sich der Umgebung angemessen in Grün und Braun gekleidet hat. Um ihre Schulter hängt ein Bogen, sie scheint jedoch sehr versunken in den Anblick des sie umgebenen Waldes."
lookatUS = "A young, pretty woman that is wearing green and brown clothes fitting into her surrounding. She got a bow shouldered but is obviously absent observating the wood and its ainmals."


-- Irundar information and five-arrow exchange.
german, "[ii]rundar" -> "Ich habe von der Höhle von Irundar gehört. Bringt mir ein paar neue Pfeile und ich erzähle Euch was ich weiß Eine Hand voll wird gengen denke ich. Und nun seid still."
english, "[ii]rundar" -> "I have heard about the Cave of Irundar. Bring me some new arrows and I will tell you what I know. A handful will suffice, I think. And now be quiet."
item(64, "all") >= 5, german, "[pp]feil", "[aa]rrow" -> "Also gut...Ich erzähle: Meine Großeltern haben mir von der Höhle von Irundar erzählt. Sie ist auf dieser Insel, ich meine im Süden. Es gibt da einen alten Reim: Die reinsten Tränen der Fee, das reinste Blut eines Trolls, immer nach vorne nur seh, betrete die Kammer voll Stolz. Dies ist alles was ich weiß aber einst traf ich einen kleinen Halbling in den Wäldern, Timo, denke ich. Er wusste wie die Höhle selbst betreten werden kann. Fragt mich nicht wo er nun steckt, fragt einfach herum. Und jetzt lasst mich bitte alleine.", deleteItem(64, 5)
item(64, "all") >= 5, english, "[pp]feil", "[aa]rrow" -> "Alright...I guess I have to talk: My grandparents told me about the Cave of Irundar. It is somewhere on this island, it is in the south I guess. There was a little verse: The purest tears of a fairy, The purest blood of a troll, still you have to be wary, and into the chamber you stroll. This is all I know, but once I met a little halfling in the forrests, Timo, I think. He knew how to enter the cave itself. Don't ask me where he is now, just ask around. And now leave me alone please.", deleteItem(64, 5)
item(64, "all") < 5, german, "[pp]feil", "[aa]rrow" -> "Versucht nicht mich zu betrügen! Ihr habt nicht gengend Pfeile dabei!"
item(64, "all") < 5, english, "[pp]feil", "[aa]rrow" -> "Don't try to cheat me! You don't have enough arrows!"

"[gg]rüß", "[hh]allo" -> "Scht! Ihr verscheucht die Tiere.", "Bleibt doch ruhig! Sonst verscheucht ihr die Tiere."
"[gg]reetings", "[hh]ello", "[hh]i" -> "Hush! You scare the animals.", "Be quiet! You scare the animals."

-- Idle dialogue
cycletext "#me blick still in den Wald hinaus", "#me quietly peers into the forest"
cycletext "#me scheint zu horchen", "#me seems to hark"
