german, "[Jj]a", queststatus=10 , item(63,belt) < 100 -> "Dummes Stück Fleisch, bring sie zuerst!", queststatus=9

english, "yes", queststatus=10, item(63,belt) > 99 -> "Your worth never stops to amaze me, living one.. Good good, give them to me and be on your way to bring me 10 bottles of the finest poison, the one that only spiders can breed", deleteitem(63,100),queststatus=11
german, "ja", queststatus=10, item(63,belt) > 99 -> "Dein Wert erstaunt mich immer wieder, Lebender... Gut, gut, gib sie mir und mach dich auf den Weg, mir 10 Flaschen des feinsten Giftes zu bringen, das nur Spinnen erzeugen können.", deleteitem(63,100),queststatus=11

english, "[Hh]ello", "[Gg]reetings", "[Hh]i", queststatus=11 -> "Do you have what I required of you? If not, you should better not waste my time anymore..", queststatus=12
german, "[Hh]allo", "[Gg]rüße", "[Gg]uten [Tt]ag", queststatus=11 -> "Hast du, was ich von dir verlangt habe? Wenn nicht, verschwende besser nicht weiter meine Zeit...", queststatus=12

english, "[Nn]o", queststatus=12 -> "Why are you wasting my time then? I am eternally busy", queststatus=11
german, "[Nn]ein", queststatus=12 -> "Warum verschwendest du dann meine Zeit? Ich bin auf ewig beschäftigt.", queststatus=11

english, "[Yy]es", queststatus=12 , item(167,belt) < 10 -> "Idiotic piece of flesh, bring them first!", queststatus=11
german, "[Jj]a", queststatus=12 , item(167,belt) < 10 -> "Dummes Stück Fleisch, bring sie zuerst!", queststatus=11

english, "yes", queststatus=12, item(167,belt) > 9 -> "Oh excellent work, dark one, excellent work indeed. Are you ready? I shall now give you a special power to help you in your next task.", deleteitem(167,10), queststatus=13
german, "ja", queststatus=12, item(167,belt) > 9 -> "Oh, ausgezeichnete Arbeit, Dunkler, wahrlich ausgezeichnet. Bist du bereit? Ich werde dir nun eine besondere Kraft verleihen, die dir bei deiner nächsten Aufgabe hilft.", deleteitem(167,10), queststatus=13

english, "yes", queststatus=13  -> " #me waves his skeletal hand in front of the %CHARRACE 's face, humming darkly 'Yes my dark friend, yes.. feel the power? Yes.. Now tell me, are you ready for the last task?' ", queststatus=14
german, "ja", queststatus=13 -> "#me bewegt seine skelettartige Hand vor dem Gesicht des %CHARRACE und summt düster. 'Ja, mein dunkler Freund, ja... Spürst du die Kraft? Ja... Sag mir nun, bist du bereit für die letzte Aufgabe?'", queststatus=14

english, "yes", queststatus=14 -> "During my... lifetime... a grand order of paladins was watching my every move, trying at every step to end my dark existence. Their leader, Antonius Cornelius, hunted me his entire life, since his childhood, when I slew his troublemaking parents. When I received the curse, he swore that one day he will destroy me, even if he'd have to wait an eternity for it. As no servant of the light would ever dare to step in this doomed place, he prayed and prayed to his weak gods, asking them for mercy. The gods showed pity to their loyal servant, blessing him with neverending life and eternal youth. Thus, even today, Antonius resides somewhere in the dungeon below, waiting for a chance to slay me, until the end of time. Find him, %CHARNAME, and end his pitiful existence. Bring me his holy sword as proof of his demise.",queststatus=15
german, "ja", queststatus=14 -> "Zu meinen... Lebzeiten... beobachtete ein großer Paladinorden jede meiner Bewegungen und versuchte auf Schritt und Tritt, meiner dunklen Existenz ein Ende zu setzen. Ihr Anführer, Antonius Cornelius, jagte mich sein ganzes Leben lang, seit seiner Kindheit, als ich seine lästigen Eltern erschlug. Als ich den Fluch erhielt, schwor er, mich eines Tages zu vernichten, selbst wenn er eine Ewigkeit darauf warten müsste. Da kein Diener des Lichts diesen verdammten Ort je betreten würde, betete er immer wieder zu seinen schwachen Göttern und bat um Gnade. Die Götter hatten Mitleid mit ihrem treuen Diener und segneten ihn mit endlosem Leben und ewiger Jugend. So haust Antonius noch heute irgendwo im Verlies unter uns und wartet bis ans Ende der Zeit auf eine Gelegenheit, mich zu erschlagen. Finde ihn, %CHARNAME, und beende seine erbärmliche Existenz. Bring mir sein heiliges Schwert als Beweis seines Todes.",queststatus=15

english, "[Hh]ello", "[Gg]reetings", "[Hh]i", queststatus=15 -> "Have you slain the paladin, %CHARNAME and brought me his sword? If not, you should better not waste my time anymore..", queststatus=16
german, "[Hh]allo", "[Gg]rüße", "[Gg]uten [Tt]ag", queststatus=15 -> "Hast du den Paladin erschlagen, %CHARNAME, und mir sein Schwert gebracht? Wenn nicht, verschwende besser nicht weiter meine Zeit...", queststatus=16

english, "[Nn]o", queststatus=16 -> "Why are you wasting my time then? I am eternally busy", queststatus=15
german, "[Nn]ein", queststatus=16 -> "Warum verschwendest du dann meine Zeit? Ich bin auf ewig beschäftigt.", queststatus=15

english, "[Yy]es", queststatus=16 , item(206,belt) < 1 -> "Idiotic piece of flesh, do what I asked!", queststatus=15
german, "[Jj]a", queststatus=16 , item(206,belt) < 1 -> "Dummes Stück Fleisch, tu, was ich verlangt habe!", queststatus=15

english, "yes", queststatus=16, item(206,belt) = 1 -> "Well done %CHARNAME, well done! I must say that I wasn't expecting you to return. Your dark heart allowed you to slay the poor paladin, you are truly worthy of bearing darkness in your soul. Receive this gift, dark one, receive it and bear it well.", queststatus=17, deleteitem(206,1), item(278,1,1001,0000)
german, "ja", queststatus=16, item(206,belt) = 1 -> "Gut gemacht, %CHARNAME, gut gemacht! Ich muss sagen, ich hatte nicht mit deiner Rückkehr gerechnet. Dein dunkles Herz ließ dich den armen Paladin erschlagen. Du bist wahrlich würdig, Dunkelheit in deiner Seele zu tragen. Empfange dieses Geschenk, Dunkler, empfange es und trage es mit Würde.", queststatus=17, deleteitem(206,1), item(278,1,1001,0000)
