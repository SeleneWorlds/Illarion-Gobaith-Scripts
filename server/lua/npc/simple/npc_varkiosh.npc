--In Work! by Avalyon	

name="Varkiosh the Forsaken"
position=-6, -6, 0
sex=neutral
race=Demon Skeleton
direction=west

QuestID = 1001

english, "[Hh]ello", "[Gg]reetings", "[Hh]i" -> "Ahh, fresh meat.. Know, mortal, that you are now in the presence of great Varkiosh, the Forsaken. I should destroy you for your trespassing, but since you are here, we should make it profitable for us both. Accept to offer me some of your blood to nourish my rotten flesh and I shall tell you a great story.", queststatus=1
german, "[Hh]allo", "[Gg]rüße", "[Gg]uten [Tt]ag" -> "Ahh, frisches Fleisch... Wisse, Sterblicher, dass du nun vor dem großen Varkiosh, dem Verlassenen, stehst. Ich sollte dich für dein Eindringen vernichten, doch da du hier bist, sollten wir beide davon profitieren. Biete mir etwas von deinem Blut, um mein verrottetes Fleisch zu nähren, und ich werde dir eine große Geschichte erzählen.", queststatus=1

english, "[Aa]lright", "[Oo]k", "[Yy]es", "[Aa]greed", "[Aa]gree","[Bb]lood", queststatus=1 -> "#me suddenly hits the %CHARRACE with his sharp bony claws, licking the blood off them afterwards 'Yeees, your blood rejuvenates me.. Thank you mortal, are you ready for my part of the deal?'", attrib(hitpoints)-3000, queststatus=2
german, "[Ii]n [Oo]rdnung", "[Oo]k", "[Jj]a", "[Ee]inverstanden", "[Ee]inverstanden", "[Bb]lut", queststatus=1 -> "#me schlägt plötzlich mit seinen scharfen knochigen Klauen nach dem %CHARRACE und leckt anschließend das Blut von ihnen. 'Jaaa, dein Blut verjüngt mich... Danke, Sterblicher. Bist du bereit für meinen Teil der Abmachung?'", attrib(hitpoints)-3000, queststatus=2

english, "[Yy]es", "[Oo]k", "[Aa]lright", queststatus=2 -> "There was once a great mage, a mage so great that all of his enemies shivered in fear only at the sound of his unholy name. Everyone feared him, everyone hated him, all wanted to see him defeated, but no power, nor man, nor creature, could face him in battle and survive. Can you comprehend this concept, mortal?", queststatus=3
german, "[Jj]a", "[Oo]k", "[Ii]n [Oo]rdnung", queststatus=2 -> "Einst gab es einen großen Magier, so groß, dass all seine Feinde allein beim Klang seines unheiligen Namens vor Angst zitterten. Jeder fürchtete ihn, jeder hasste ihn, alle wollten ihn besiegt sehen. Doch keine Macht, kein Mensch und keine Kreatur konnte ihm im Kampf gegenübertreten und überleben. Kannst du das begreifen, Sterblicher?", queststatus=3

english, "[Yy]es", "[Ii]ndeed", queststatus=3 -> "Know, mortal, that this great mage, loyal servant of the dark gods, was tricked and ambushed by no less than 50 mages. The battle lasted more than 7 days, at the end, the mage stepping on the burning ashes of his carbonised enemies. Shall I continue?", queststatus=4
german, "[Jj]a", "[Ii]n der [Tt]at", queststatus=3 -> "Wisse, Sterblicher, dass dieser große Magier, treuer Diener der dunklen Götter, von nicht weniger als 50 Magiern überlistet und in einen Hinterhalt gelockt wurde. Der Kampf dauerte mehr als sieben Tage. Am Ende stand der Magier auf der brennenden Asche seiner verkohlten Feinde. Soll ich fortfahren?", queststatus=4

english, "[Nn]o", queststatus=4 -> "Then get out of my sight!"
german, "[Nn]ein", queststatus=4 -> "Dann verschwinde aus meinen Augen!"

english, "[Yy]es", "[Pp]lease", queststatus=4 -> "The mage destroyed all of his enemies, but he himself, received a serious, magic wound, that he could not manage to heal. Gathering his remaining strength, he warped himself to the temple of his worshipped gods, praying to them for healing. But no.. the gods considered him unworthy for allowing himself to receive the hit and instead of healing, he received a gruesome curse... Do you know who that mage was, mortal?", queststatus=5
german, "[Jj]a", "[Bb]itte", queststatus=4 -> "Der Magier vernichtete alle seine Feinde, doch er selbst erlitt eine schwere magische Wunde, die er nicht heilen konnte. Mit seiner verbliebenen Kraft teleportierte er sich in den Tempel seiner Götter und bat sie um Heilung. Doch nein... Die Götter hielten ihn für unwürdig, weil er sich hatte treffen lassen. Statt Heilung erhielt er einen grausamen Fluch... Weißt du, wer dieser Magier war, Sterblicher?", queststatus=5

english, "[Yy]ou", queststatus=5 -> "Indeed mortal, my soul has been cursed to inhabit this decaying body for all eternity, being bound to guard this infernal temple, where, a long time ago, I have kneeled to the gods asking them for healing. I will never leave this place, mortal, for that my curse is given by the gods and it is eternal. Do a few tasks for me, frail one, and you shall have my gratitude. Do you accept?", queststatus=6
german, "[Dd]u", queststatus=5 -> "In der Tat, Sterblicher. Meine Seele wurde dazu verflucht, diesen verfallenden Körper für alle Ewigkeit zu bewohnen und diesen höllischen Tempel zu bewachen, in dem ich vor langer Zeit vor den Göttern kniete und um Heilung bat. Ich werde diesen Ort niemals verlassen, Sterblicher, denn mein Fluch stammt von den Göttern und ist ewig. Erledige ein paar Aufgaben für mich, Schwächling, und ich werde dir dankbar sein. Nimmst du an?", queststatus=6

english, "[Nn]o", queststatus=6 -> "Then get out of my sight!"
german, "[Nn]ein", queststatus=6 -> "Dann verschwinde aus meinen Augen!"

english, "[Yy]es", "[Aa]lright", "[Oo]k", "[Aa]gree", queststatus=6 -> "Very well, mortal one, then this it shall be. I may be a lich now, but I am still a powerful mage.. they robbed me of my life, but my powers they did not take, and my supply of mana potions has long expired. Bring me 20 bottles and we shall discuss further", queststatus=7
german, "[Jj]a", "[Ii]n [Oo]rdnung", "[Oo]k", "[Ee]inverstanden", queststatus=6 -> "Sehr gut, Sterblicher, dann soll es so sein. Ich mag nun ein Lich sein, doch ich bin noch immer ein mächtiger Magier... Sie raubten mir mein Leben, aber nicht meine Kräfte. Mein Vorrat an Manatränken ist längst erschöpft. Bring mir 20 Flaschen und wir werden weiterreden.", queststatus=7

english, "[Hh]ello", "[Gg]reetings", "[Hh]i", queststatus=7 -> "Do you have what I required of you? If not, you should better not waste my time anymore..", queststatus=8
german, "[Hh]allo", "[Gg]rüße", "[Gg]uten [Tt]ag", queststatus=7 -> "Hast du, was ich von dir verlangt habe? Wenn nicht, verschwende besser nicht weiter meine Zeit...", queststatus=8

english, "[Nn]o", queststatus=8 -> "Why are you wasting my time then? I am eternally busy", queststatus=7
german, "[Nn]ein", queststatus=8 -> "Warum verschwendest du dann meine Zeit? Ich bin auf ewig beschäftigt.", queststatus=7

english, "[Yy]es", queststatus=8 , item(165,belt) < 20 -> "Idiotic piece of flesh, bring them first!", queststatus=7
german, "[Jj]a", queststatus=8 , item(165,belt) < 20 -> "Dummes Stück Fleisch, bring sie zuerst!", queststatus=7

english, "[Yy]es", queststatus=8, item(165,belt) > 19 -> "Ah, excellent my dark friend, excellent indeed. Let us continue, shall we? I require to use the dark energies for a ritual, but I have no items to draw them from. Be so kind and bring me around 100 entrails and we shall see what will follow.", deleteitem(165,20), queststatus=9
german, "[Jj]a", queststatus=8, item(165,belt) > 19 -> "Ah, ausgezeichnet, mein dunkler Freund, wahrlich ausgezeichnet. Fahren wir fort? Ich benötige dunkle Energien für ein Ritual, habe jedoch keine Gegenstände, aus denen ich sie schöpfen könnte. Sei so freundlich und bring mir etwa 100 Eingeweide, dann sehen wir weiter.", deleteitem(165,20), queststatus=9

english, "[Hh]ello", "[Gg]reetings", "[Hh]i", queststatus=9 -> "Do you have what I required of you? If not, you should better not waste my time anymore..", queststatus=10
german, "[Hh]allo", "[Gg]rüße", "[Gg]uten [Tt]ag", queststatus=9 -> "Hast du, was ich von dir verlangt habe? Wenn nicht, verschwende besser nicht weiter meine Zeit...", queststatus=10

english, "[Nn]o", queststatus=10 -> "Why are you wasting my time then? I am eternally busy", queststatus=9
german, "[Nn]ein", queststatus=10 -> "Warum verschwendest du dann meine Zeit? Ich bin auf ewig beschäftigt.", queststatus=9

