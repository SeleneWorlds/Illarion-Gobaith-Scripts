name="Flora"
race=human
position= -115, -84, 0
direction=east
sex=female

-- Queststats:
-- 1 - Does Player like flowers?
-- 2 - Player likes flower. Can he be asked a question?
-- 3 - Did Player ever see Night Angels Blossom?
-- 4 - Player asked to bring a Night Angels Blossom.
-- 5 - Player never seen a Night Angels Blossom
-- 6 - Player agrees to bring the flower
-- 7 - Player disagrees to bring the flower
-- 8 - Player brought the flower
-- 10 - Quest completed (NPC will offer healing capabilities)

QuestID = 558

-- CYCLE TEXT
cycletext( "#me hockt sich hin und betrachtet die Blumen aufmerksam, wobei sie leicht die Stirn runzelt.", "#me crouches down and looks closely at the flowers, frowning slightly." )
cycletext( "#me riecht an einer Blume in ihrer Hand.", "#me sniffs a flower she's holding." )
cycletext( "#me flüstert etwas Unverständliches, während sie die Blütenblätter einer Blume abzupft.", "#me whispers something inaudible while plucking out the petals of a flower." )

-- Queststatus = 10 (COMPLETED) (Person wounded)
english, "hello", queststatus = 10, attrib( hitpoints ) < 1500 -> "Hello again. Oh, you seem to be wounded. Would you allow me to tend to your wounds?", queststatus = 11
german, "hallo", queststatus = 10, attrib( hitpoints ) < 1500 -> "Hallo wieder. Oh, du scheinst verwundet zu sein. Darf ich deine Wunden versorgen?", queststatus = 11
english, "greet", queststatus = 10, attrib( hitpoints ) < 1500 -> "Greetings again. Hmm, you seem to be hurt. May I tend to your wounds?", queststatus = 11
german, "grüß", queststatus = 10, attrib( hitpoints ) < 1500 -> "Sei erneut gegrüßt. Hm, du scheinst verletzt zu sein. Darf ich deine Wunden versorgen?", queststatus = 11
-- Queststatus = 10 (COMPLETED) (Person named)
english, "hello", queststatus = 10, state = 1 -> "Hello %CHARNAME, it is always nice seeing you."
german, "hallo", queststatus = 10, state = 1 -> "Hallo %CHARNAME, es ist immer schön, dich zu sehen."
english, "greet", queststatus = 10, state = 1 -> "%CHARNAME, a pleasure seeing you again."
german, "grüß", queststatus = 10, state = 1 -> "%CHARNAME, schön, dich wiederzusehen."
-- Queststatus = 10 (COMPLETED) (Person not named)
english, "hello", queststatus = 10 -> "Hello again there! It is so nice to see you."
german, "hallo", queststatus = 10 -> "Hallo wieder! Es ist so schön, dich zu sehen."
english, "greet", queststatus = 10 -> "Greetings once again. It is always nice seeing you."
german, "grüß", queststatus = 10 -> "Sei erneut gegrüßt. Es ist immer schön, dich zu sehen."
english, "farewell", queststatus = 10 -> "Farewell and come back soon to see me!"
german, "leb wohl", queststatus = 10 -> "Leb wohl und komm bald wieder zu mir!"

english, "yes", queststatus = 11, attrib( hitpoints ) < 1500 -> "#me uses a small bottle of liquid which helps cure the wounds, 'There you go. You should feel better.'", attrib( hitpoints ) + 5000, queststatus = 10
german, "ja", queststatus = 11, attrib( hitpoints ) < 1500 -> "#me versorgt die Wunden mit der Flüssigkeit aus einer kleinen Flasche. 'So. Jetzt sollte es dir besser gehen.'", attrib( hitpoints ) + 5000, queststatus = 10
english, "sure", queststatus = 11, attrib( hitpoints ) < 1500 -> "#me applies a small bottle of liquid, soothing the pain of the wounds, 'There. You should feel less pain now.'", attrib( hitpoints ) + 5000, queststatus = 10
german, "sicher", queststatus = 11, attrib( hitpoints ) < 1500 -> "#me trägt die Flüssigkeit aus einer kleinen Flasche auf und lindert den Wundschmerz. 'So. Jetzt sollten die Schmerzen nachlassen.'", attrib( hitpoints ) + 5000, queststatus = 10
english, "yes", queststatus = 11 -> "Oh well, you aren't that bad. I'll heal you when you are in a worse condition."
german, "ja", queststatus = 11 -> "Nun, so schlecht geht es dir gar nicht. Ich werde dich heilen, wenn du in einem schlechteren Zustand bist."
english, "no", queststatus = 11 -> "If you insist. Take care then.", queststatus = 10
german, "nein", queststatus = 11 -> "Wenn du darauf bestehst. Pass auf dich auf.", queststatus = 10

english, "thank", queststatus = 10, state = 6 -> "I am glad to be of help, just as you were to me."
german, "dank", queststatus = 10, state = 6 -> "Ich helfe dir gern, so wie du mir geholfen hast."

english, "why", queststatus >= 2 -> "My mother used to tell me stories about this wonderful flower. But now she passed away, and I have no memories of her. The flower can serve as one."
german, "warum", queststatus >= 2 -> "Meine Mutter erzählte mir früher Geschichten über diese wundervolle Blume. Doch nun ist sie verstorben und ich habe kein Andenken an sie. Die Blume könnte eines sein."

-- Queststatus = 1
english, "I like flowers", queststatus = 1 -> "You like the flowers? That makes me happy! May I ask you a question?", queststatus = 2
german, "ich mag blumen", queststatus = 1 -> "Du magst die Blumen? Das freut mich! Darf ich dir eine Frage stellen?", queststatus = 2
english, "I love flowers", queststatus = 1 -> "You love the flowers? Wow, I love them too! Can I ask you a question?", queststatus = 2
german, "ich liebe blumen", queststatus = 1 -> "Du liebst die Blumen? Oh, ich liebe sie auch! Darf ich dir eine Frage stellen?", queststatus = 2
english, "yes", queststatus = 1 -> "Oh you like them too? That is so nice to hear. May I ask you a question?", queststatus = 2
german, "ja", queststatus = 1 -> "Oh, du magst sie auch? Das ist schön zu hören. Darf ich dir eine Frage stellen?", queststatus = 2
english, "no", queststatus = 1 -> "Oh, pity. You should look at them closely, their colors, their scent, it's a unique sensation.", queststatus = 0
german, "nein", queststatus = 1 -> "Oh, schade. Du solltest sie genau betrachten, ihre Farben und ihren Duft. Es ist ein einzigartiges Erlebnis.", queststatus = 0

-- Queststatus = 2
