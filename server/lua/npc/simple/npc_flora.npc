german, "nein", queststatus = 3 -> "Oh, wie schade. Mein größter Wunsch ist es, diese Blume zu sehen und ihren Duft zu erleben.", queststatus = 5
english, "never", queststatus = 3 -> "#me frowns then, before she says, 'A pity. You know, my biggest wish is to see the Night Angels Blossom.'", queststatus = 5
german, "nie", queststatus = 3 -> "#me runzelt die Stirn, bevor sie sagt: 'Schade. Mein größter Wunsch ist es, eine Nachtengelsblüte zu sehen.'", queststatus = 5
