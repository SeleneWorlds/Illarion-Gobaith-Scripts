-- Derived from npc/artoss_ishem.lua; UTF-8.

name = "Artoss Ishem"
race = human
sex = male
position = -54, -218, 0
direction = west
language = common
language = human
defaultLanguage = common
autointroduce = on
useMsgDE = "Finger weg!"
useMsgUS = "Don't you touch me!"
wrongLangDE = "#me sieht dich leicht verwirrt an"
wrongLangUS = "#me looks at you a little confused"

"hallo", "grüße", "seid.+gegrüßt", "guten.+tag", "tag", "moin" -> "Ich grüße euch.", "Guten Tag.", "Seid gegrüßt"
"wer.+seid.+ihr?", "wer.+bist.+du?" -> "Ich bin Artoss Ishem, Ritter der Grauen Rose."
"wo.+bin.+ich?", "was.+ist.+das.+hier?" -> "Ihr befindet euch bei der Grauen Zuflucht.", "Das ist die Graue Zuflucht", "Das ist die Graue Zuflucht, Heimat der Ritter der Grauen Rose!"
"was.+macht.+ihr?" -> "Ich stehe hier Wache."
"was.+verkaufst.+du?", "was.+verkauft.+ihr?" -> "Ich verkaufe nichts, tut mir leid. Sam verkauft etwas in der Burg.", "Geht zu Sam.", "Ich verkaufe nichts."
german, "sam", "wer.+ist.+sam?" -> "Sam ist ein einfacher Händler hier in der Burg. Er verkauft Kleidung, Werkzeuge, Kerzen und Lampenöl."
german, "wo.+ist.+die.+nordmark?", "nordmark" -> "Die Nordmark findet ihr wenn ihr von hier aus nach Westen geht. Sobald ihr am Meer angekommen seid, geht nach Norden. Passt aber auf, die haben harte Gesetze."
german, "wo.+ist.+trolls.+bane?", "trolls.+bane", "bane" -> "Troll's Bane ist leicht zu finden. Ihr folgt den Weg einfach über die südliche Brücke. Dort den Weg folgen und schon steht ihr vor den Stadtmauern. Seid aber auf der Hut! Es gibt dort viele Kriminelle!"
german, "wo.+ist.+greenbriar?", "greenbriar", "briar" -> "Oh. Wenn ihr nach Greenbriar wollt seid ihr hier falsch. Am besten folgt ihr dem Weg südlich nach Troll's Bane. Von dort aus geht ihr weiterhin südlich zur Union. Dort angekommen lauft ihr gen Westen, vorbei an dem Hafen, bis zu einer Brücke. Dort geht ihr rüber und dann nach Süden. Die Halblinge sind immer freundlich. Dort lässt es sich leben."
german, "wo.+ist.+varshikar?", "varshikar" -> "Die Wüstenstadt findet ihr wenn ihr von hier aus nach Troll's Bane lauft. Von dort aus den Weg vorbei an Garon's Werkstatt immer nach Osten den Weg folgen. Es ist sehr heiß dort aber man hat nette Gesellschaft! Und passt auf, in der nähe hausen Orks!"
german, "wo.+ist.+silberbrand?", "silberbrand" -> "Zu den zwergen kommt ihr am schnellsten wenn ihr die Brücke überquert und dann dem Fairy Tear's nach Osten folgt. Die Zwerge sind manchmal richtig mürrisch. Aber ihr Bier ist das Beste weit und breit!"
"hilfe" -> "[Spielhilfe] Dies ist ein NPC welcher dir etwas über die Graue Rose erzählen kann. Außerdem kann er dir sagen wo du verschiedene Städte findest."
german, "was.+ist.+die.+graue.+rose?", "graue.+rose", "rose", "graue.+zuflucht" -> "Die Grause Rose ist der älteste Ritterzirkel auf Gobaith. Er besteht in der Regel aus dem hohen Zirkel, den Rittern und dem Gefolge. Die Graue Rose ist stets nach Gleichgewicht bestrebt und nimmt gerne neues Gefolge auf."
"hello", "greetings", "be.+greeted", "good.+day" -> "Be greeted!", "Good day.", "I greet you."
"who.+are.+you?" -> "I am Artoss Ishem, Knight of the Grey Rose."
"where.+am.+i?", "what.+is.+this?" -> "You are at the Grey Refuge.", "This is the Grey Refuge.", " This is the Grey Refuge, home of the knights of the Grey Rose."
"what.+are.+you.+doing?" -> "I am guarding."
"what.+do.+you.+sell?" -> "I don't sell anything. Ask Sam in the castle.", "Go to Sam.", "I don't sell anything."
english, "who.+ist.+sam?", "sam" -> "Sam is a simply merchant in the castle. There you can buy clothes, tools, candles and lampoil."
english, "where.+is.+the.+nordmark?", "nordmark" -> "You'll find the Nordmark if you go west. Once you reach the sea walk north. But beware, they have hard laws."
english, "where.+is.+trolls.+bane?", "trolls.+bane", "bane" -> "Troll's Bane is easy to find. Just follow the path over the bridge. Follow the path south and you already see the town walls."
english, "where.+is.+greenbriar?", "greenbriar", "briar" -> "Oh. If you want to go to Greenbriar, you're totally wrong here. The best way is that you first go to Troll's Bane. From there you have to go south to the union. At the union you have to go west, pass the habor and walk over the bridge. From there just go south. The halflings are always friendly and it is a good place to live."
english, "where.+is.+varshikar?", "varshikar" -> "You'll find the desert town if you go to Troll's Bane and turn east. Pass Garon's workshop and follow the way east. It is very hot there but you'll find some nice people. And pay attention, in the mountains are some strong creatures!"
english, "where.+is.+silverbrand?", "silverbrand", "silberbrand" -> "The fastest way to the dwarves is if you pass the bridge and follow the Fairy Tear's on the other side of the river. Sometime the dwarfs are grumbly but their beer is the best on Gobaith!"
"help" -> "[Gamehelp] This is an NPC who can tell you something about the Grey Rose and where you can find the other towns."
english, "what.+is.+the.+grey.+rose?", "grey.+rose", "rose", "grey.+refuge" -> "The Grey Rose is the oldest knight circle on Gobaith. Usually it consists of the high circle, the knights and the following. The Grey Rose is always striving for balance on Gobaith and is always looking for followers."

-- Idle dialogue
cycletext "#me richtet seine Rüstung.", "#me adjusts his armor."
cycletext "#me poliert seine Rüstung mit einem sauberen Tuch.", "#me polishes his armor with a clean cloth."
cycletext "#me beißt in einen Apfel.", "#me bites into an apple."
cycletext "Willkommen in der Grauen Zuflucht!", "Welcome to the Grey Refuge!"
cycletext "#me blickt sich mit wachsamen Augen um.", "#me looks around with an observant gaze."
cycletext "#me strafft seine Schultern.", "#me squares his shoulders."
cycletext "#me gähnt verhalten.", "#me yawns retained."
cycletext "#mes Rüstung strahlt vor glanz.", "#mes armor is shining of brightness."
cycletext "#me kämmt gepflegt sein Haar.", "#me combs his hair."
