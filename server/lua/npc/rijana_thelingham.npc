-- Derived from npc/rijana.lua; UTF-8.

name = "Rijana Thelingham"
race = human
sex = male
position = -16, -4, -57
direction = east
job = "Restricted trader"
language = common
language = human
language = ancient
defaultLanguage = common
autointroduce = on
useMsgDE = "Finger weg!"
useMsgUS = "Don't you touch me!"
wrongLangDE = "#me sieht dich leicht verwirrt an"
wrongLangUS = "#me looks at you a little confused"

-- Trade offers and requests; stock and trader cash are unlimited.
sellItem = id(3109), price(35), stack(1), quality(333)
buyPrimaryItem = id(3109), price(5)
sellItem = id(329), price(60), stack(1), quality(333)
buyPrimaryItem = id(329), price(5)
sellItem = id(323), price(1000), stack(1), quality(333)
sellItem = id(547), price(1000), stack(1), quality(333)
sellItem = id(548), price(1500), stack(1), quality(333)
buyPrimaryItem = id(164), price(3)

"[gg]reetings", "[hh]ello", "[hh]i" -> "Welcome. Can I help you?", "A good day to you."
"[yy]ou.+[tt]rader" -> "I am %NPCNAME, I sell some usefull things. Do you need something?"
"[tt]ell.+[aa]cademy" -> "I'm not good in history. If you want to know something about the magic academy better ask someone else."
"[ww]hat.+sell" -> "I sell potions and some usefull stuff for mages."
"[ww]hat.+[pp]otion" -> "I sell mana potions and antidots. And I have some bottles of ink."
"[ww]hat.+[bb]ottle" -> "I trade with empty bottles."
"[gg]oodbye", "[bb]ye", "[ff]arewell" -> "You are going? Good luck for your studies.", "Take care of you.", "Farewell. I hope you will come back soon."
"[ww]hat.+buy" -> "I buy empty bottles, open pells and ink."
"[ww]ho.+you?" -> "My name is %NPCNAME."
"i'm.+.+" -> "Nice to meet you. Did you need anything?"
"[hh]elp" -> "'List your wares', 'I want to buy <number> <wares>', 'I want to buy a <ware>', 'I want to sell <number|a> <wares>', 'Price of ...','What do you pay for ...', 'What wares do you buy?'"
"[gg]r[üu][ßs]+", "[hh]allo" -> "Seid gegrüßt. Kann ich euch behilflich sein?", "Guten Tag."
"[dd]u.+[hh]ändler" -> "Ich bin %NPCNAME. Ich verkaufe einige nützliche Dinge hier. Braucht ihr etwas?"
"[ww]as.+verkauf" -> "Ich verkaufe Tränke sowie diverse Ausrüstung für Magier."
"[ww]as.+[tt]r[aä]nk" -> "Ich verkaufe Manatranke und Gegengifte. Ich hab sogar ein paar Flaschen Tinte."
"[ww]as.+[ff]lasch" -> "Ich handel mit leeren Flaschen"
"[ee]rzähl.+[aa]kademie" -> "Ich bin nicht so gut in Geschichte. Am besten fragt ihr deswegen jemand anderes."
"[aa]uf.+[bb]ald", "[bb]is.+[bb]ald" -> "Willst du schon gehen? Viel Glück bei deinen Studien.", "Du gehst schon? Gib auf dich acht, ich hoffe wir sehen uns bald wieder"
"[ww]as.+%s[kk]auf" -> "Ich kaufe leere Flaschen, offene Pergamentrollen und Tinte."
"[ww]er.+[ddii][uh]r*?" -> "Ich werde %NPCNAME genannt."
"[hh]ilfe" -> "'Welche Waren verkauft ihr', 'Ich möchte <Anzahl> <Ware> kaufen', 'Ich möchte <Ware> kaufen', 'Ich möchte <Anzahl> <Ware> verkaufen', 'Was ist der Preis von <Ware>','Was zahlt ihr für <Ware>', 'Was kauft ihr?'"

-- Open the trading menu.
"trade", "buy", "sell", "wares", "handel", "kauf", "verkauf", "waren" -> trade

-- Idle dialogue
cycletext "#me notiert ein paar Zahlen auf ein Stück Pergament.", "#me notes a few numbers on a piece of pergament."
cycletext "#me sortiert ein paar Dinge in ihrer Truhe neu.", "#me rearranges some things in her chest. "
