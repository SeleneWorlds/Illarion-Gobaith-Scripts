use: german -> "Finger weg!"
use: english -> "Don't you touch me!"

chat: match("[hh]elp") -> "'List your wares', 'I want to buy <number> <wares>', 'I want to buy a <ware>', 'I want to sell <number|a> <wares>', 'Price of ...','What do you pay for ...', 'What wares do you buy?'"

chat: match(
    "[gg]reet",
    "[hh]ello",
    "[hh]i",
) -> pick(
    "Greetingsss. How i can help you?.",
    "Aye! You are interested in my wares?",
)

chat: match("[ww]hat.+sell") -> "I sell different tools"

chat: match("[ww]hat.+[tt]ool") -> "Whatever you want: scrissors, saws, hammers, shovels, needles, axes, sickles, scythes and glas blow pipes."

chat: match("[ww]ho.+[ii]rmorom") -> "Irmorom is the god of the dwarves, of the trade and the craftsmanship"

chat: match(
    "[bb]ye",
    "[ff]arewell",
) -> pick(
    "Aye! Irmorom may bless you.",
    "Farewell. You are welcome to come back and to trade with me.",
)

chat: match(
    "[gg]r[uü][sß]+",
    "[hh]allo",
) -> pick(
    "Aye! Was willst du?",
    "Hallo. Willst du was von meinen Waren kaufen?",
)

chat: match("[ww]as.+kauf") -> "Ja, ich habe Verschiedene Werkzeuge."

chat: match("[ww]as.+[ww]erkzeug") -> "Was auch immer dir helfen mag: Scheren, Sägen, Hammer, Schaufeln, Nadeln, Äxte, Sicheln, Sensen und Glasblas Rohre."

chat: match(
    "[aa]uf.+[bb]ald",
    "[bb]is.+[bb]ald",
) -> pick(
    "Ja, du kannst gern wieder herkommen, wenn du was brauchst. Irmorom sei mit dir!",
    "Aye! Kannst gern wieder herkommen, wenn du was brauchst.",
)

chat: match("[ww]er.+[ii]rmorom") -> "Irmorom ist der Gott der Zwerge, des Handels und der Handwerker"

chat: chatTrading("gambi")
