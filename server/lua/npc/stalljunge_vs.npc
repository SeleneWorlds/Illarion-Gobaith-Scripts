"esel.+kaufen", "kaufe.+esel", "lasttier.+kaufen", "kaufe.+lasttier", "mule.+kaufen", "kaufe.+mule", "donkey.+kaufen", "kaufe.+donkey", "pack.+animal.+kaufen", "kaufe.+pack.+animal" -> "Ich verkaufe keine Lasttiere. Ich verleihe sie nur."
"buy.+esel", "buy.+lasttier", "buy.+mule", "buy.+donkey", "buy.+pack.+animal" -> "I do not sell pack animals. I only rent them out."
"koste", "preis" -> "Die Leihgebühr beträgt 50 Kupferstücke, die Kaution 2 Silberstücke. Bei Rückgabe bekommt ihr die Kaution zurück."
"cost", "price" -> "The rental fee is 50 copper coins, plus a deposit of 2 silver coins. You get the deposit back on return."

"[hh]ello", "[gg]reetings", "[hh]i" -> "Hello, Hello"
"[hh]allo", "[gg]r[uü][sß]+" -> "Grüße euch!"
"[ww]ho.+" -> "I am %NPCNAME"
"[ww]er.+" -> "Ich bin %NPCNAME."
"[ff]arewell" -> "Farewell!"
"[bb]ye.+" -> "Be well"
"[ww]as.+verkauf" -> "Ich verkaufe nicht! Ich verleihe Esel als Transport- und Lastentiere."
"[ww]hat.+sell" -> "I don't sell! But you can lend a mule as pack animal."
"[aa]uf.+[bb]ald", "[bb]is.+[bb]ald" -> "Bis Bald"
"[kk]uh" -> "Ich habe keine Kühe, ich habe nur Esel hier."
"cow" -> "I have no cows, I have just mules."

