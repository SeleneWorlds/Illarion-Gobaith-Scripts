"[gg]reetings", "[hh]ello" -> "Welcome. How can I help you?", "Good day. Do you need something?"
"[gg]rü[ßs]+e", "[hh]allo" -> "Willkommen. Wie kann ich euch helfen?", "Guten Tag. Braucht ihr etwas?"
"[yy]ou.+[tt]rader" -> "A trader I am, right. I trade very different wares."
"[iidd][hu][r.+].*[hh]ändler" -> "Ich bin ein Händler, richtig. Ich handle mit verschiedenen Waren."
"[ww]hat.+sell" -> "I sell all kinds of wares for everyday use."
"[ww]as.+verkauf" -> "Ich verkaufe alle Arten von Waren für den täglichen Gebrauch."
"[ww]hat.+[ww]ares" -> "Resources, for example. Or different tools."
"[ww]as.+[ww]are" -> "Rohstoffe zum Beispiel. Oder verschiedene Werkzeuge."
"[tt]ell.+[ss]omething" -> "Once upon a time, I came here. Now I am here. Isn't that interesting?"
"[ee]rzähl.+was" -> "Es war einmal, da kam ich hier her. Jetzt bin ich da. Ist das nicht interessant?"
"[gg]oodbye", "[ff]arewell", "[bb]ye" -> "Have a nice day.", "Goodbye.", "Farewell!"
"[aa]uf.+[bb]ald", "[tt]schüs", "[bb]is.+[bb]ald" -> "Bis bald.", "Schönen Tag noch.", "Auf bald!"
"[ww]ho.+you?" -> "My name is %NPCNAME."
"[ww]er.+[iidd][hu][r.+]?" -> "Ich bin %NPCNAME."
"i'm.+.+" -> "Nice to meet you."
"ich.+bin.+.+" -> "Erfreut euch kennen zu lernen."
"[hh]elp" -> "'List your wares', 'I want to buy <number> <wares>', 'I want to buy a <ware>', 'I want to sell <number|a> <wares>', 'Price of ...','What do you pay for ...', 'What wares do you buy?'"
"[hh]ilfe" -> "'Welche Waren verkauft ihr', 'Ich möchte <Anzahl> <Ware> kaufen', 'Ich möchte <Ware> kaufen', 'Ich möchte <Anzahl> <Ware> verkaufen', 'Was ist der Preis von <Ware>','Was zahlt ihr für <Ware>', 'Was kauft ihr?'"

-- Open the trading menu.
"trade", "buy", "sell", "wares", "handel", "kauf", "verkauf", "waren" -> trade
