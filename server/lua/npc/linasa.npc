-- Trade offers and requests; stock and trader cash are unlimited.
sellItem = id(1061), price(100), stack(1), quality(3), durability(33), data("destination" = "illarion:trolls_bane"), de("Trolls Bane"), en("Trolls Bane")
sellItem = id(1061), price(100), stack(1), quality(3), durability(33), data("destination" = "illarion:lighthouse"), de("Lighthouse"), en("Lighthouse")
