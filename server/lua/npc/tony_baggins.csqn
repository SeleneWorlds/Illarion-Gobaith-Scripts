lookat: german -> "Ein laufender Meter, der da ans Fass lehnt und sich mit einem Fächer aus Blättern Luft zuwedelt. Er ist ganz in grün gekleidet und hat Sommersprossen um die Nase."
lookat: english -> "A midget leaning against that barrel there waving himself some air with a fan made of leaves. He is completely clad in green fabric and his nose is covered with freckles."

use: german -> "Hee! Finger weg!"
use: english -> "Hee! Don't you touch me!"

chat: match(
    "[gg]reetings",
    "[hh]ello",
) -> pick(
    "Hiho. How can I help you?",
    "Hello. Do you need something? I'm alchemist and dyes of all colors. All are selfmade!",
)

chat: match(
    "[gg]rü[ßs]+e",
    "[hh]allo",
) -> pick(
    "Hiho! Wie kann ich dir helfen? Ich habe allerhand Farben. Alle selbst gemacht!",
    "Hallo. Wer bist du denn?.",
)

chat: match("[yy]ou.+[tt]rader") -> "Yes, i trade with dyes and ingredients to make them."

chat: match("[ddii][uh]r*.+[hh][äa]ndler") -> "Ja, ich handle mit Farben und Zutaten zur Herstellung von Farben."

chat: match("[yy]ou.+[hh]ealer") -> "No, i am not. I am alchemist and sell dyes"

chat: match("[ddii][uh]r*.+[hh]eiler") -> "Nein bin ich nicht. Ich bin Alchemist und verkaufe Farben."

chat: match("[ww]hat.+sell") -> "Do you want that i list my wares? Here take a look at the best dyes you can find!"

chat: match("[ww]as.+verkauf") -> "Willst du eine Liste meiner Waren sehen? Hier, schau. Das sind die besten Farben die du finden wirst"

chat: match("[ww]hat.+[ww]ares") -> "I trade with dyes and ingredients to make them."

chat: match("[ww]as.+[ww]aren") -> "Ich handele mit Farben und Zutaten zu deren Herstellung."

chat: match("[ww]hat.+[pp]otion") -> "I have no potions anymore. I only trade with dyes and ingredients to make them."

chat: match("[ww]as.+[tt]ränke") -> "Ich habe keine Tränke mehr. Ich handele nur noch mit Farben und Zutaten zu deren Herstellung."

chat: match("[ww]hat.+[cc]loth") -> "I don't trade with cloth anymore. The business with cloths didn't work."

chat: match("[ww]as.+[kk]leidung") -> "Ich habe keine Kleidung mehr im Angebot. Das Geschäft mit den abgetragenen Klamotten lief nicht gut."

chat: match("[ww]hat.+[mm]ore") -> "I need different tools and goods to make dyes"

chat: match("[ww]as.+[mm]ehr") -> "Ich brauche verschiedene Werkzeuge und Sachen um Farben herzustellen."

chat: match("[ww]hat.+[dd]ye") -> "I'm an alchemist and prepare differnet dyes. You are interested in red, blue, yellow or other?."

chat: match("[ww]as.+[ff]arbe") -> "Ja, ich bin Alchemist und verkaufe verschiedene Farben. Bist du vielleicht an Rot oder Blau interessiert? Was anderes?"

chat: match(
    "[gg]oodbye",
    "[bb]ye",
    "[ff]arewell",
) -> pick(
    "Have a nice day. Oldra my bless you.",
    "Farewell!",
    "Good day.",
)

chat: match(
    "[aa]uf.+[bb]ald",
    "[bb]is.+[bb]ald",
) -> pick(
    "Schönen Tag noch! Oldra segne euch!",
    "Schönen Tag!",
)

chat: match("[ww]ho.+you?") -> "My name is Tony Baggins. I am an alchemist and I work here. But I come from Greenbriar. Do you know my home village?"

chat: match("[ww]er.+[ddii][uh]r*") -> "Ich bin Tony Baggins. Ich bin Alchemist und arbeite hier. Aber ich komme von Greenbriar. Kennst du mein Heimatdorf?"

chat: match("i'm.+.+") -> "Nice to meet you. Do you need my help?"

chat: match("[ii]ch.+[bb]in") -> "Freut mich! Kann ich dir helfen?"

chat: match("[hh]elp") -> "'List your wares', 'I want to buy <number> <wares>', 'I want to buy a <ware>', 'I want to sell <number|a> <wares>', 'Price of ...','What do you pay for ...', 'What wares do you buy?', 'Tell <something>'"

chat: match("[hh]ilfe") -> "'Welche Waren verkauft ihr', 'Ich möchte <Anzahl> <Ware> kaufen', 'Ich möchte <Ware> kaufen', 'Ich möchte <Anzahl> <Ware> verkaufen', 'Was ist der Preis von <Ware>','Was zahlt ihr für <Ware>', 'Was kauft ihr?', 'Erzähl über <etwas>'"

chat: chatTrading("tony_baggins")
