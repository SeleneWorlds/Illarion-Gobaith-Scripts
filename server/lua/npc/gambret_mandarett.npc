"[hh]ello", "[gg]reetings" -> "Hello", "Greetings"
"[hh]allo", "[gg]r[üu][ßs]+" -> "Hallo", "Grüße"
"[ww]hat.+buy" -> "Ill buy cutlery, plates and bowls, cups, goblets, bottles and cooking tools."
"[ww]as.+%skauf" -> "Ich kaufe Besteck, Teller und Schüsseln, Becher, Kelche, diverse Flaschen und Kochutensilien."
"[ww]hat.+do" -> "I buy table supplies for the tavern"
"[ww]as.+[tm][ua][tsc]" -> "Ich kaufe Tisch Gedeck für die Taverne"
"[ww]ho.+you" -> "Gambret."
"[ww]er.+[ddii][uh]r*" -> "Gambret."
"[ii]['.+]*m.+" -> "Alright then. Have anything to sell me?"
"[ii]ch.+[bb]in" -> "In Ordnung. Habt ihr was, das ihr mir verkaufen könntet?"
"[bb]ye", "[ff]arewell" -> "Goodbye", "Goodbye"
"[aa]uf.+[bb]ald", "[bb]is.+[bb]ald" -> "Auf bald", "Auf bald"
"[hh]elp" -> "'List your wares', 'I want to buy <number> <wares>', 'I want to buy a <ware>', 'I want to sell <number|a> <wares>', 'Price of ...','What do you pay for ...', 'What wares do you buy?'"
"[hh]ilfe" -> "'Welche Waren verkauft ihr', 'Ich möchte <Anzahl> <Ware> kaufen', 'Ich möchte <Ware> kaufen', 'Ich möchte <Anzahl> <Ware> verkaufen', 'Was ist der Preis von <Ware>','Was zahlt ihr für <Ware>', 'Was kauft ihr?'"

-- Open the trading menu.
"trade", "buy", "sell", "wares", "handel", "kauf", "verkauf", "waren" -> trade
