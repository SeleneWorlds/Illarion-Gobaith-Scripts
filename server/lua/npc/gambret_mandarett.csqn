use: german -> "Finger weg!"
use: english -> "Don't you touch me!"

chat: match(
    "hello",
    "greetings"
) -> pick(
    "Hello",
    "Greetings"
)

chat: match("what.+buy") -> "I'll buy cutlery, plates and bowls, cups, goblets, bottles and cooking tools.", showTrades("gambret_mandarett")
chat: match("what.+do") -> "I buy table supplies for the tavern", showTrades("gambret_mandarett")
chat: match("who.+you") -> "Gambret."
chat: match("i[' ]*m.+") -> "Alright then. Have anything to sell me?"

chat: match(
    "bye",
    "farewell"
) -> "Goodbye"

chat: match("help") -> "'List your wares', 'I want to buy <number> <wares>', 'I want to buy a <ware>', 'I want to sell <number|a> <wares>', 'Price of ...','What do you pay for ...', 'What wares do you buy?'"

chat: match(
    "hallo",
    "gr[üu][ßs]+"
) -> pick(
    "Hallo",
    "Grüße"
)

chat: match("was.+kauf") -> "Ich kaufe Besteck, Teller und Schüsseln, Becher, Kelche, diverse Flaschen und Kochutensilien.", showTrades("gambret_mandarett")
chat: match("was.+[tm][ua][tsc]") -> "Ich kaufe Tisch Gedeck für die Taverne", showTrades("gambret_mandarett")
chat: match("wer.+[di][uh]r*") -> "Gambret."
chat: match("ich.+bin") -> "In Ordnung. Habt ihr was, das ihr mir verkaufen könntet?"

chat: match(
    "auf.+bald",
    "bis.+bald"
) -> "Auf bald"

chat: match("hilfe") -> "'Welche Waren verkauft ihr', 'Ich möchte <Anzahl> <Ware> kaufen', 'Ich möchte <Ware> kaufen', 'Ich möchte <Anzahl> <Ware> verkaufen', 'Was ist der Preis von <Ware>','Was zahlt ihr für <Ware>', 'Was kauft ihr?'"

chat: chatTrading("gambret_mandarett")
