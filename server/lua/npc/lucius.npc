-- Derived from old/lucius.lua; UTF-8.
-- Archived Lua remains the reference for custom behavior.
name = "Lucius van Sareth"
race = human
sex = male
position = 267, -303, 0
direction = west
language = common
language = human
defaultLanguage = common
autointroduce = on
useMsgDE = "Finger weg!"
useMsgUS = "Don't you touch me!"


"[tt]ax", "[ss]teuer" -> lua("npc.custom.tax_collector", "collect", "varshikar")
"what.+day.+today", "what.+today.+day", "what.+date", "welch.+tag.+heute", "was.+tag.+heute", "was.+datum", "welch.+datum" -> lua("npc.custom.calendar", "date")

"[gg]reetings", "[hh]ello" -> "Greetings. Can I help you?", "Be greeted. I'm %NPCNAME. Can I help you?"
"[gg]rü[ßs]+e", "[hh]allo" -> "Grüße. Kann ich euch helfen?", "Guten Tag. Ich bin %NPCNAME. Kann ich euch helfen?"
"[yy]ou.+[tt]rader" -> "No. I'm no trader. I'm the tax collector of Varshikar."
"[ddii][uh]r*.+[hh]ändler" -> "Nein ich bin kein Händler. Ich bin der Steuereintreiber von Varshikar."
"[ww]hat.+sell" -> "Nothing. I'm no trader so I sell nothing."
"[ww]as.+verkauf" -> "Ich bin kein Händler also verkaufe ich auch nichts."
"[tt]ell.+[ss]omething" -> "Sorry, I'm pretty busy right now."
"[ee]rzähl.+[ww]as" -> "Tut mir leid, ich bin grad ziemlich beschäftigt."
"[gg]oodbye", "[bb]ye", "[ff]arewell" -> "Be well.", "Farewell!", "Goodbye."
"[aa]uf.+[bb]ald", "[bb]is.+[bb]ald" -> "Auf Wiedersehen.", "Auf bald"
