-- Derived from old/jeyne_terelorn.lua; UTF-8.
-- Archived Lua remains the reference for custom behavior.
name = "Jeyne Terelorn"
language = common
language = human
defaultLanguage = common
autointroduce = on
useMsgDE = "Finger weg!"
useMsgUS = "Don't you touch me!"


german, "hallo", "grüße", "tach", "hiho" -> "Seid gegrüßt. Sagt, könntet Ihr mir helfen?", state = 1
english, "hello", "greetings", "hiho" -> "Greetings to you. Can you help me?", state = 1
state = 1, "hilfe", "helfen", "ja" -> "Mein Sohn...er ist verschwunden! Könnt Ihr mir helfen, ihn zu suchen?", state = 2
state = 1, "help", "yes" -> "My son...he dissapeared! Can you help me finding him?"
state = 2, "ja", "sicher" -> "Danke vielmals! Ich befürchte er ist wieder im [WALD], dabei habe ich es ihm doch verboten! Ich suche hier, geht Ihr bitte zum [WALD].", queststatus(999) = 1
state = 2, "yes", "sure" -> "Thank you! I fear he's at the [WALD] again, though I told him it's dangerous there! I'll search here, please go to the [WALD] and see if he's there.", queststatus(999) = 1
"verkauf" -> "Ich verkaufe nichts."
"kauft", "kaufst" -> "Ich kaufe nichts."

