-- Derived from old/tihgorac.lua; UTF-8.
-- Archived Lua remains the reference for custom behavior.
name = "Tihgorac"
language = common
language = orc
defaultLanguage = common
autointroduce = on
useMsgDE = "Fast mich nicht an!"
useMsgUS = "Don't you touch me!"
lookatDE = "Ein Hüne von einem Ork, der bedrohlich seine Hauer fletscht. Sein Blick wirkt dennoch etwas unsicher, wenn er an seinen Gürtel greift, wo allerdings nur eine leere Öse zu sehen ist. Etwas scheint zu fehlen."
lookatUS = "A giant of an orc who keeps baring his tusks. His gaze is a little unsecure though when he reaches for his belt where you see nothing but an empty scabbard. Something seems to be missing."


-- Quest 2112: 0 not started, 1 offered, 2 awaiting innards, 3 awaiting axe, 4 taught.
queststatus(2112) = 4, german, ".+" -> "Hab dir schon was begebracht. Mehr zeig ich nix."
queststatus(2112) = 4, english, ".+" -> "I show you already. More i don't show you."
queststatus(2112) = 0, german, "[ww]arrior", "[ff]ighter", "[ss]oldier", "[kk]rieger", "[ss]oldat", "[kk]ämpfer" -> "Ja. %NPCNAME stark Krieger. Du willst Krieger werden?", queststatus(2112) = 1
queststatus(2112) = 0, english, "[ww]arrior", "[ff]ighter", "[ss]oldier", "[kk]rieger", "[ss]oldat", "[kk]ämpfer" -> "Yes. %NPCNAME strong warrior. You want become warrior?", queststatus(2112) = 1
queststatus(2112) > 0, queststatus(2112) < 4, german, "[ww]arrior", "[ff]ighter", "[ss]oldier", "[kk]rieger", "[ss]oldat", "[kk]ämpfer" -> "Ja. %NPCNAME stark Krieger. Du willst Krieger werden?"
queststatus(2112) > 0, queststatus(2112) < 4, english, "[ww]arrior", "[ff]ighter", "[ss]oldier", "[kk]rieger", "[ss]oldat", "[kk]ämpfer" -> "Yes. %NPCNAME strong warrior. You want become warrior?"
queststatus(2112) = 1, german, "[yy]es", "[jj]a" -> "%NPCNAME weis nicht ob du stark genug. Bringt nix, Krieger sein zu wollen und die verfluchten Tempel Mummien nicht morschen zu können.", queststatus(2112) = 2
queststatus(2112) = 1, english, "[yy]es", "[jj]a" -> "%NPCNAME nub knows if yoo is strong enuf, yets. No use even tryins to beh warrior, if yoo can'ts beat cursed temple mummies even.", queststatus(2112) = 2
queststatus(2112) = 2, item(63, "all") >= 1, german, "[ii]nners", "[ee]ntrails", "[ee]ingeweid" -> "Har. Hast %NPCNAME überzeugt, aber ich hab Probleme. %NPCNAME war in Sümpfen, große Viecher tot kloppen, als ich meine Axt verlorn hab. %NPCNAME konnt sie nicht wieder finden - Ich musste die Mistvicher mit meinen Händen verhaun. Find meine Axt und %NPCNAME bring dir was bei!", deleteItem(63, 1), queststatus(2112) = 3
queststatus(2112) = 2, item(63, "all") >= 1, english, "[ii]nners", "[ee]ntrails", "[ee]ingeweid" -> "Yubba. Yoo has proven yerself, but %NPCNAME has troubles. Meh was in de swamps fightin' big critters when %NPCNAME dropped meh axe. %NPCNAME nub could finds it - had tuh fight big critters wid fists! Hur hur! Find meh axe and %NPCNAME will teach yoos.", deleteItem(63, 1), queststatus(2112) = 3
queststatus(2112) = 2, item(63, "all") < 1, german, "[ii]nners", "[ee]ntrails", "[ee]ingeweid" -> "Ugh! Hast Innereinen? Oder bist du schwächlich?"
queststatus(2112) = 2, item(63, "all") < 1, english, "[ii]nners", "[ee]ntrails", "[ee]ingeweid" -> "Ugh! You have innards, yet? Or is you weakling?"
queststatus(2112) = 3, german, "[ii]nners", "[ee]ntrails", "[ee]ingeweid" -> "Hast %NPCNAME schon Innerein gegeben."
queststatus(2112) = 3, english, "[ii]nners", "[ee]ntrails", "[ee]ingeweid" -> "Yoo allready give inners to %NPCNAME."
queststatus(2112) < 2, german, "[ii]nners", "[ee]ntrails", "[ee]ingeweid" -> "Innerein? Haben die verfluchten Tempel Mumien."
queststatus(2112) < 2, english, "[ii]nners", "[ee]ntrails", "[ee]ingeweid" -> "Inners?! The cursed temple mummies have them."
-- Reverse the legacy axe list: CheckAxt selected the last matching item.
queststatus(2112) = 3, item(2946, "all") >= 1, skill("concussion weapons") <= 25, german, "[aa]x[et]" -> "#me zeigt ein Manöver mit der Axt", deleteItem(2946, 1), skill("concussion weapons") + 5, queststatus(2112) = 4, "Jetzt du!", inform("Du denkst du das vielleicht etwas gelernt hast, dadurch das du ihm zugesehen hast.")
