lookat: german -> "Ein braun gebrannter Mann, der stolz vor einigen Kisten steht, in denen diverse Rüstungsteile und gefiederte Pfeile liegen."
lookat: english -> "A tanned man who stands proudly in front of a few chests in which you see certain armour pieces as well as feathered arrows."

use: german -> "Finger weg!"
use: english -> "Don't you touch me!"

chat: match(
    "[gg]reetings",
    "[hh]ello",
) -> pick(
    "Welcome. How can I help you?",
    "Good day. Do you need something? I have cheap wares!",
)

chat: match(
    "[gg]rü[sß]+e",
    "[hh]allo",
) -> pick(
    "Willkommen. Kann ich euch helfen?",
    "Guten Tag? Braucht ihr etwas? Ich habe billige Waren",
)

chat: match("[yy]ou.+[tt]rader") -> "A trader I am, that's right. I trade different kinds of wares."

chat: match("[ddii][uh]r*.+[hh]ändler") -> "Ich bin Händler, das ich richtig. Ich handel mit verschiedensten Waren."

chat: match("[ww]hat.+sell") -> "I sell mostly smithed weapons."

chat: match("[ww]as.+verkauf") -> "Ich verkaufe geschmiedete Waffen."

chat: match("[tt]ell.+[ss]omething") -> "Once upon a time, I came here. Now I am here. Isn't that interesting?"

chat: match("[ee]rzähl.+[ww]as") -> "Vor langer Zeit, kam ich hier her. Jetzt bin ich da. Ist das nicht interessant?"

chat: match(
    "[gg]oodbye",
    "[bb]ye",
    "[ff]arewell",
) -> pick(
    "Have a nice day.",
    "Farewell!",
    "Good bye.",
)

chat: match(
    "[aa]uf.+[bb]ald",
    "[bb]is.+[bb]ald",
) -> pick(
    "Schönen Tag.",
    "Auf bald",
)

chat: match("[ww]ho.+you?") -> "My name is Nadir."

chat: match("[ww]er.+[ddii][uh]r*") -> "Mein Name ist Nadir."

chat: match("i'm.+.+") -> "Nice to meet you."

chat: match("[ii]ch.+[bb]in") -> "Freut mich euch kennen zu lernen"

chat: match("[hh]elp") -> "'List your wares', 'I want to buy <number> <wares>', 'I want to buy a <ware>', 'I want to sell <number|a> <wares>', 'Price of ...','What do you pay for ...', 'What wares do you buy?'"

chat: match("[hh]ilfe") -> "'Welche Waren verkauft ihr', 'Ich möchte <Anzahl> <Ware> kaufen', 'Ich möchte <Ware> kaufen', 'Ich möchte <Anzahl> <Ware> verkaufen', 'Was ist der Preis von <Ware>','Was zahlt ihr für <Ware>', 'Was kauft ihr?'"

chat: chatTrading("nadir")
