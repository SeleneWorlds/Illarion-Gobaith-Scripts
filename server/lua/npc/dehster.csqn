use: german -> "Finger weg!"
use: english -> "Don't you touch me!"

cycle: pick(
    if(german, "#me blickt sich nach neuen Kunden um", "#me looks around for a new cosmtumer."),
    if(german, "#me summt eine glückliche Melodie", "#me hums a happy melodie"),
    if(german, "#me sieht sich mit einem Lächeln auf den Lippen um", "#me looks around with a smile on his face"),
)

chat: match(
    "[gg]reet",
    "[hh]ello",
) -> pick(
    "Greetings. I'm Dehster, travelling hawker",
    "Hello. I'm Dehster, travelling hawker.",
)

chat: match("[ww]hat.+do") -> "I m here to trade. I come from Gobaith to sell different tools and buy other things from here."

chat: match("[ll]ist.+wares") -> "I trade with different things. Take a look."

chat: match("[ww]hat.+sell") -> "I sell tools and food."

chat: match("[ww]hat.+buy") -> "I buy different things."

chat: match("[ww]hat.+[tt]ool") -> "Of every kind what people can need here. Axes and saws for lumberjacks, craving tools and planes for carpenters and some other for bakers and cooks."

chat: match(
    "[ff]arewell",
    "[gg]oodbye",
) -> pick(
    "Farewell.",
    "Bye!",
)

chat: match("[hh]elp") -> "'List your wares', 'I want to buy <number> <wares>', 'I want to buy a <ware>', 'I want to sell <number|a> <wares>', 'Price of ...','What do you pay for ...', 'What wares do you buy?', 'Tell <something>'"

chat: match(
    "[gg]rü[ßs]+e",
    "[hh]allo",
) -> pick(
    "Willkommen, ich bin Dehster, ein fliegender Händler.",
    "Guten Tag, ich bin Dehster, ein fliegender Händler.",
)

chat: match("[ww]as.+machst") -> "Ich bin von Gobaith und bringe jeden Tag Dinge des täglichen Bedarfs mit."

chat: match("[ww]as.+verkauf") -> "Ich verkaufe vor allem Werkzeuge und mancherlei anderes. Schau selbst!"

chat: match("[ww]as.kauf") -> "Ich kaufe verschiedene Dinge an."

chat: match("[ww]as.+[ww]erkzeu") -> "Alles was die Leute hier gebrauchen können: Äxte udn Sägen für die Holzfäller, Schnitzmesser und Hobel für Schreiner und mancherlei mehr für Köche und Bäker."

chat: match(
    "[tt]schüs",
    "[aa]uf.+[bb]ald",
    "[bb]is.+[bb]ald",
) -> pick(
    "Schönen Tag noch.",
    "Bis bald.",
    "Auf bald!",
)

chat: match("[hh]ilfe") -> "'Welche Waren verkauft ihr', 'Ich möchte <Anzahl> <Ware> kaufen', 'Ich möchte <Ware> kaufen', 'Ich möchte <Anzahl> <Ware> verkaufen', 'Was ist der Preis von <Ware>','Was zahlt ihr für <Ware>', 'Was kauft ihr?'"

chat: chatTrading("dehster")
