-- Derived from old/lagan.lua; UTF-8.
-- Archived Lua remains the reference for custom behavior.
name = "Lagan"
language = common
defaultLanguage = common
autointroduce = on
useMsgDE = "Don't you touch me!"
useMsgUS = "Don't you touch me!"

sellItem = id(1), price(50), stack(1), quality(333)
buyPrimaryItem = id(3), price(2)
sellItem = id(16), price(30), stack(1), quality(333)
sellItem = id(18), price(40), stack(1), quality(333)
buyPrimaryItem = id(21), price(1)
buyPrimaryItem = id(22), price(2)
sellItem = id(23), price(8), stack(1), quality(333)
sellItem = id(24), price(8), stack(1), quality(333)
sellItem = id(27), price(20), stack(1), quality(333)
buyPrimaryItem = id(28), price(2)
buyPrimaryItem = id(13), price(2)

"[gg]reetings" -> "Good day. How are you doing?"
"[hh]ello" -> "I wish you a good day. What can I do for you?"
"[yy]ou.+[tt]rader" -> "Yes, I trade wares."
"[ww]hat.+sell" -> "I sell everything you need for smithing."
"[tt]ell.+[ss]omething" -> "I don't know what to. You might want to talk to the librarian in Troll's Bane. I am sure he can tell you stories."
"[tt]ell.+[ss]ibanac" -> "Sibanac can be smoked in pipes. I tend to like it. It makes me feel good."
"[gg]oodbye" -> "Have a good day. Feel welcome to come back any time."
"[bb]ye" -> "Farewell."
"[ff]arewell" -> "Goodbye!"
"[ww]ho.+you?" -> "I'm %NPCNAME."
"i'm" -> "Nice to meet you. Do you want to buy some of my wares. Look at what i have. Or do you want to sell something to me?"
"[hh]elp" -> "Say trade, buy, sell or wares to browse my goods and prices."

"trade", "buy", "sell", "wares", "handel", "kauf", "verkauf", "waren" -> trade

