use: german -> "Finger weg!"
use: english -> "Don't you touch me!"

chat: match(
    "[gg]reetings",
    "[hh]ello",
) -> pick(
    "Welcome. How can I help you?",
    "Good day. Do you need something?",
)

chat: match(
    "[gg]rü[ßs]+e",
    "[hh]allo",
) -> pick(
    "Willkommen. Wie kann ich euch helfen?",
    "Guten Tag. Braucht ihr etwas?",
)

chat: match("[yy]ou.+[tt]rader") -> "A trader I am, right. I trade very different wares."

chat: match("[iidd][hu][r.+].*[hh]ändler") -> "Ich bin ein Händer, richtig. Ich handle mit verschiedenen Waren."

chat: match("[ww]hat.+sell") -> "I sell all kinds of wares for everyday useage."

chat: match("[ww]as.+verkauf") -> "Ich verkaufe alle Arten von Waren für den täglichen Gebrauch."

chat: match("[ww]hat.+[ww]ares") -> "Ressources, for example. Or different tools."

chat: match("[ww]as.+[ww]are") -> "Rohstoffe zum Beispiel. Oder verschiedene Werkzeuge."

chat: match("[tt]ell.+[ss]omething") -> "Once upon a time, I came here. Now I am here. Isn't that interesting?"

chat: match("[ee]rzähl.+was") -> "Es war einmal, da kam ich hier her. Jetzt bin ich da. Ist das nicht interessant?"

chat: match(
    "[gg]oodbye",
    "[ff]arewell",
    "[bb]ye",
) -> pick(
    "Have a nice day.",
    "Good bye.",
    "Farewell!",
)

chat: match(
    "[aa]uf.+[bb]ald",
    "[tt]schüs",
    "[bb]is.+[bb]ald",
) -> pick(
    "Bis bald.",
    "Schönen Tag noch.",
    "Auf bald!",
)

chat: match("[ww]ho.+you?") -> "My name is Mugush."

chat: match("[ww]er.+[iidd][hu][r.+]?") -> "Ich bin Mugush."

chat: match("i'm.+.+") -> "Nice to meet you."

chat: match("ich.+bin.+.+") -> "Erfreut euch kennen zu lernen."

chat: match("[hh]elp") -> "'List your wares', 'I want to buy <number> <wares>', 'I want to buy a <ware>', 'I want to sell <number|a> <wares>', 'Price of ...','What do you pay for ...', 'What wares do you buy?'"

chat: match("[hh]ilfe") -> "'Welche Waren verkauft ihr', 'Ich möchte <Anzahl> <Ware> kaufen', 'Ich möchte <Ware> kaufen', 'Ich möchte <Anzahl> <Ware> verkaufen', 'Was ist der Preis von <Ware>','Was zahlt ihr für <Ware>', 'Was kauft ihr?'"

chat: chatTrading("mugush")
