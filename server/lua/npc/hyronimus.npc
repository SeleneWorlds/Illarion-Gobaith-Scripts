"[hh]ello", "[gg]reetings" -> "Greetings my friend.", "A pleasure to meet you, friend."
"[hh]allo", "[gg]rü[sß]+e" -> "Grüße mein Freund.", "Ist mir eine Freude euch zu treffen."
"[mm]ission" -> "My friend, I am selling potions to adventurers who fight the evil in the dungeon of Hellbriar."
"[aa]uftrag" -> "Mein Freund, ich verkaufe Tränke an alle Abenteurer, die die Hölle von Briar betreten."
english, "[qq]uest" -> "My friend, I am a simple man with no needs."
german, "[qq]uest" -> "Mein Freund, ich bin ein einfacher Mann ohne Bedürfnisse."
"[gg]rave" -> "I take care of them as well as I can, but sometimes they even scare me."
"[gg]r[aä]b" -> "Ich kümmere mich um sie, so gut ich kann, aber manchmal erschrecken sie sogar mich."
"[ww]hat.+sell" -> "I cannot offer you much, but my potions."
"[ww]as.+verkaufen" -> "Ich kann nicht viel anbieten. Vielleicht ein paar Tränke."
"[ww]hat.+buy" -> "I fear, my friend, that there is nothing I would want to buy right now."
"[ww]as.+%skauf" -> "Ich fürchte, mein Freund, es gibt nichts was ich im Augenblick von euch kaufen würde."
"[ww]ho.+[yy]ou" -> "I am Brother %NPCNAME of the White Flame."
"[ww]er.+[ddii][uh]r*" -> "Ich bin Bruder %NPCNAME von der Weißen Flamme."
"[hh]ellbriar" -> "The foul armies of death and decay live in this area."
"[hh]ölle" -> "Die Armeen des Todes und der Finsternis leben in diesem Gebiet."
"[bb]ye", "[ff]are.*well" -> "Walk in peace, my friend.", "Walk in peace, my friend."
"[aa]uf.+[bb]ald", "[bb]is.+[bb]ald" -> "Geh in Frieden, mein Freund.", "Geh in Frieden, mein Freund."
"[hh]elp" -> "'List your wares', 'I want to buy <number> <wares>', 'I want to buy a <ware>', 'I want to sell <number|a> <wares>', 'Price of ...','What do you pay for ...', 'What wares do you buy?'"
"[hh]ilfe" -> "'Welche Waren verkauft ihr', 'Ich möchte <Anzahl> <Ware> kaufen', 'Ich möchte <Ware> kaufen', 'Ich möchte <Anzahl> <Ware> verkaufen', 'Was ist der Preis von <Ware>','Was zahlt ihr für <Ware>', 'Was kauft ihr?'"

-- Open the trading menu.
"trade", "buy", "sell", "wares", "handel", "kauf", "verkauf", "waren" -> trade
