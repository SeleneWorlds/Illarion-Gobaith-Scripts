use: german -> "Finger weg!"
use: english -> "Don't you touch me!"

cycle: pick(
    if(german, "#me rülpst", "#me burps"),
    if(german, "#me zieht eine kleine Flasche aus der Tasche und trinkt einen Schluck", "#me pulls a bottle out of his pocket and takes a sip"),
)

chat: english, match("gobaith") -> "Gobaith?  Dis liddle Island?  I hate it!"

chat: german, match("gobaith") -> "Gobaith?  Diese kleine Insel? Ich hasse es!"

chat: english, match("greenbriar") -> "Are joo hungry? Halflings make gud snacks, yubba!"

chat: german, match("greenbriar") -> "Haben Sie Hunger? Halblenge machen gute Imbisse!"

chat: english, match("orc") -> "Yubba!  Meh mighty Orc!"

chat: german, match("orc") -> "Ich bin ein mächtiger Ork!"

chat: german, match("ork") -> "Ich bin ein mächtiger Ork!"

chat: match("orc.+cave") -> "Just go North and see Tihgorac.  Go through Cave and up ladder.  Keep North and see Higdish."

chat: german, match("orc.+cave") -> " Gehen Sie gerade Norden und sieh Tihgorac. Gehen Sie Höhle und Leiter durch. Behalten Sie Norden und sieh Higdish."

chat: english, match("varshikar") -> "Oomie desert town.  Just go East, joo cant miss it."

chat: german, match("varshikar") -> " Menschliche Wüste-Stadt. Gehen Sie gerade Osten, Sie können nicht es verpassen!"

chat: match("i.+am") -> "Nice to meet joo."

chat: match("i'm") -> "Nice to meet joo."

chat: match("ich.+bin") -> "Nett dich kennen su lernen."

chat: match("silberbrand") -> "#me spuckt auf dem Grund und bleibt still."

chat: match("silverbrand") -> "#me spits on the ground and remains silent."

chat: english, match("troll.+bane") -> "It beh in middle ob Island.  Big Oomie town it beh."

chat: german, match("troll.+bane") -> "Es ist in der Mitte der Insel. Es ist eine große menschliche Stadt."

chat: match("gr[üue]+[sß]+e") -> "Hallo! Was wollen Sie?"

chat: match("greetings") -> "Greebas! Whub joo want?"

chat: match("greets") -> "Greebas! Whub joo want?"

chat: match("greeb+[a]+s") -> "Greebas friend!  How can meh help joo?"

chat: match("hail") -> "Greebas!  Whub joo want?"

chat: match("hallo") -> "Hallo! Was wollen Sie?"

chat: match("hello") -> "Greebas! Whub joo want?"

chat: match("auf.+bald") -> "Tchuss!"

chat: match("farewell") -> "Farrebas!"

chat: match("bye") -> "Farrebas!"

chat: match("mission") -> "Meh mission is to guard dis Border."

chat: match("beruf") -> "Meine Mission ist, diese Grenze zu schützen."

chat: match("deine.+aufgabe") -> "Meine Mission ist, diese Grenze zu schützen."

chat: match("eure.+aufgabe") -> "Meine Mission ist, diese Grenze zu schützen."

chat: match("job") -> "Meh job is to guard dis border!"

chat: match("t[äae]+tigkeit") -> "Meine Mission ist, diese Grenze zu schützen."

chat: match("was.+tust.+du") -> "Meine Mission ist, diese Grenze zu schützen."

chat: match("was.+tut.+ihr") -> "Meine Mission ist, diese Grenze zu schützen."

chat: match("what.+you.+do") -> "Meh job is to guard dis border!"

chat: match("dein.+name") -> "Mein name? Ich heiße %npcname"

chat: match("you.+name") -> "My name?  I beh %npcname"

chat: match("mein.+name") -> "Sehr angenem. Ich heiße %NPCNAME."

chat: match("my.+name") -> "Keh, gud to meet joo.  Meh beh %NPCNAME."

chat: match("wie.+hei[sß]+t.+du") -> "Ich heißße %NPCNAME."

chat: match("helfen") -> "Ihr wolld mir helfen? Gud, bringt mir eine Flasche Bier!"

chat: match("help") -> "Joo wanna help me?  Gud, bring meh a bottle ob Beer!"

chat: match("hilfe") -> "Ihr wolld mir helfen? Gud, bringt mir eine Flasche Bier!"

chat: match("how.+are.+you") -> "Gud."

chat: match("wie.+geht.+es") -> "Gut."

chat: match("buy") -> "Meh nub buy anyding!"

chat: match("kaufen") -> "Ich kaufe gar nix!"

chat: match("sell") -> "Meh nub sell anyding."

chat: match("verkaufen") -> "Ich verkaufe gar nix!"

chat: match("neu") -> "Du bist neu hier? Geh am besten in die Stadt Osten, Varshikar, und suche nach Leuten, die dir helfen können."

chat: match("i[.+a']+m.+new") -> "You are new to Illarion? You should visit the town to the East, Varshikar. Search for people who can help you."

chat: match("newbie") -> "You are new to Illarion? You should visit the town to the East, Varshikar. Search for people who can help you."

chat: match("where.+am.+i") -> "Joo are on da Border to da Orcs lands!"

chat: match("wo.+bin.+ich") -> " Sie sind auf der Grenze zu den Orks lande!"

chat: match("who") -> "Meh job is to guard dis Border"

chat: match("wer.+seid") -> "Mein Job soll diese Grenze schützen."

chat: match("wer") -> "Mein Job soll diese Grenze schützen."

chat: match("quest") -> "Nubba Quest here.  Ask anudder Guard."

chat: match("wache") -> "Die Wache? Wir sind besten!"

chat: match("guard") -> "The Guards?  Weh are da best!"
