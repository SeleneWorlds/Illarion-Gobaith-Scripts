lookat: german -> "Ein Halbling, gekleidet wie sein Zwilling in Bane, in Grün und Sommersprossen zieren sein Gesicht. Er untersucht gerade einige getrocknete Blumen."
lookat: english -> "One more Halfling clad just like his twin in Bane, with green clothes and freckles covering his face. At the moment he is examining some dried flowers."

use: german -> "Finger weg!"
use: english -> "Don't you touch me!"

chat: match(
    "[gg]reetings",
    "[hh]ello",
    "[hh]i",
) -> pick(
    "Welcome to Greenbriar my friend! Can I help you?",
    "A good day to you my friend! You look fine today.",
)

chat: match("[yy]ou.+[tt]rader") -> "I am Floro Baggins, one of Greenbriar's best traders!"

chat: match("[tt]ell.+[gg]reenbriar") -> "I'm not as good in history as Timo is. If you want to now something of Greensbriar talk to him my friend."

chat: match("[ww]ho.+[tt]imo") -> "Timo is the trader over there my friend."

chat: match("[ww]here.+[tt]imo") -> "#me points right to the halfling near the house"

chat: match("[ww]hat.+sell") -> "I sell herbs."

chat: match("[ww]hat.+[hh]erb") -> "I trade with all kinds of different herbs. Firnis blossoms for example. What to you my list of wares?"

chat: match("[ww]hat.+[pp]otion") -> "I do not have any potions anymore"

chat: match("[ww]hat.+[bb]ottle") -> "I trade with big and small empty bottles."

chat: match(
    "[gg]oodbye",
    "[bb]ye",
    "[ff]arewell",
) -> pick(
    "You are going my friend? Take care of yourself.",
    "You are already on the way my friend? Take care of yourself and have a good meal.",
    "Farewell. I hope you will come back soon my friend.",
)

chat: match("[ww]hat.+buy") -> "I prefer to buy herbs and bottles."

chat: match("[ww]ho.+you?") -> "My name is Floro Baggins my friend."

chat: match("i'm.+.+") -> "That is the name of a good friend. Nice to meet you!"

chat: match("[hh]elp") -> "'List your wares', 'I want to buy <number> <wares>', 'I want to buy a <ware>', 'I want to sell <number|a> <wares>', 'Price of ...','What do you pay for ...', 'What wares do you buy?'"

chat: match(
    "[gg]r[üu][ßs]+",
    "[hh]allo",
) -> pick(
    "Hallo mein Freund, du siehst heute wieder gut aus.",
    "Guten Tag mein Freund! Wie geht es dir mein Freund?",
)

chat: match("[dd]u.+[hh]ändler") -> "Ich bin Floro Baggins, einer von Greenbriars besten Händlern mein Freund!"

chat: match("[ww]as.+verkauf") -> "Ich verkauf' Pflanzen und Flaschen."

chat: match("[ww]as.+[pp]flanz") -> "Ich handel ne ganze Menge Pflanzen und Kräuter. Firnisblüten zum Beispiel."

chat: match("[ww]as.+[tt]r[aä]nk") -> "Ich habe keine Tränke mehr."

chat: match("[ww]as.+[ff]lasch") -> "Ich handel mit großen und kleinen leeren Flaschen"

chat: match("[ee]rzähl.+[gg]reenbriar") -> "Ich bin bei weitem nicht so gut in Geschichte wie Timo. Am besten sprichst du mit ihm mein Freund."

chat: match("[ww]er.+[tt]imo") -> "Timo ist der Händler dort drüben mein Freund."

chat: match("[ww]o.+[tt]imo") -> "#me deutet nach Rechts auf den Halbling neben dem Haus"

chat: match(
    "[aa]uf.+[bb]ald",
    "[bb]is.+[bb]ald",
) -> pick(
    "Du bist schon auf dem Weg mein Freund? Pass auf dich auf und komm bald wieder!",
    "Du gehst schon mein Freund? Gib auf dich acht und iss was Gutes!",
)

chat: match("[ww]as.+%s[kk]auf") -> "Ich kauf' Pflanzen und Tränke. Hast du sowas dabei?"

chat: match("[ww]er.+[ddii][uh]r*?") -> "Ich werde Floro Baggins genannt mein Freund."

chat: match("[ii]ch.+bin") -> "Das ist der Name eines guten Freundes. Schön dich kennen zu lernen!"

chat: match("[hh]ilfe") -> "'Welche Waren verkauft ihr', 'Ich möchte <Anzahl> <Ware> kaufen', 'Ich möchte <Ware> kaufen', 'Ich möchte <Anzahl> <Ware> verkaufen', 'Was ist der Preis von <Ware>','Was zahlt ihr für <Ware>', 'Was kauft ihr?'"

chat: chatTrading("floro_baggins")
