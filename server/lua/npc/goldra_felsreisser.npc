-- Derived from old/goldra_felsreisser.lua; UTF-8.
-- Archived Lua remains the reference for custom behavior.
name = "Goldra Felsreisser"
race = dwarf
sex = female
position = 112, -198, -3
direction = south
radius = 0
language = common
language = dwarf
defaultLanguage = common
autointroduce = on
useMsgDE = "Nimm deine Finger da wech!"
useMsgUS = "Dont ya' touch me!"
lookatDE = "Sie trägt eine neu aussehende Wächterrobe mit einem aufgestickten Wappen Silberbrands darauf. In der Hand hält die grimmig blickende Zwergin eine große, doppelschneidige Axt, während sie ihren Blick aufmerksam schweifen lässt."
lookatUS = "She wears a quite new-looking Guardian's robe with an embroidered emblem of Silverbrand on it. The frowning looking dwarf holds a big, sharp axe in her hand, whilst her eyes wander across the hall."


german, "[mm]ein.+[nn]ame.+ist.*", "[ii]c[hk].+bin.*", "man.+nennt.+mich.*", "[ii]c[hk].+hei[sß][se].*" -> "Freut mich %CHARNAME, nenn mick Goldra, ick bin von der Bürgerwehr Silberbrands!", state = 1
english, "[mm]y.+[nn]ame.+is.*", "[ii].+am.*" -> "A pleasure %CHARNAME, call me Goldra, I'm from the Militia of Silverbrand!", state = 1
state = 1, "[gg]rü[sß]", "[hh]allo", "[gg]rue[sß]", "[tt]a[gc].*" -> "Tach %CHARNAME, schön dich mal wieder hier zu treffen.", "Grüß dich %CHARNAME, schön dich mal wiederzusehen."
"[aa]uf.+[bb]ald", "[gg]ötter.+euch", "[bb]is.+[bb]ald", "[uu]ff.+[bb]ald", "[ff]ünf.+euch" -> "Irmorom mit dir."
"[gg]rü[sß]", "[hh]allo", "[gg]rue[sß]", "[tt]a[gc].*" -> "Tach auch.", "Grüß dich!"
"[aa]uf.+[bb]ald", "[gg]ötter.+euch", "[bb]is.+[bb]ald", "[uu]ff.+[bb]ald", "[ff]ünf.+euch" -> "Auf bald. Irmorom mit dir."
"[ww]er.+[bs][ie][si][td].+[di][uh].*", "[ww]ie.+[nn]ame" -> "Ick bin die %NPCNAME von der Bürgerwehr Silberbrands, jau! Ick bin Torwächterin. Und wer bist du?"
"[hh]ilfe", "helfen", "hilf" -> "Ick fürchte ick kann dir nich' helfen, muss hier Wache stehen. Frag am besten nen anderen Zwergen nach Hilfe."
english, "where.+am.+[ii]" -> "You are in Silverbrand, the town of the dwarfes on Gobaith."
german, "[ww]o.+bin.+ich" -> "Das hier ist Silberbrand, die Stadt der Zwerge auf Gobaith."
english, "[hh]ow.+are.you" -> "I am fine and how are ya'?."
german, "[ww]ie.+gehts" -> "Eigentlich ganz gut, danke der Nachfrage.", "Mir geht es gut und dir?"
state = 1, "[gg]reeting", "[hh]ello" -> "Be greeted %CHARNAME, nice to see ya here again.", "Greetings %CHARNAME, nice to see ya again"
"[gg]reeting", "[hh]ello" -> "Be greeted %CHARNAME, nice to see ya here again.", "Greetings %CHARNAME, nice to see ya again"
"[gg]oodbye", "[bb]ye", "[ff]arewell", "[ff]ive.+you" -> "Farewell. Irmorom with ya.", "Goodbye"
"[ww]ho.+you", "[ww]hat.+[nn]ame" -> "I am %NPCNAME, from the militia of Silverbrand, aye! I guard the gates and who are ya'?"
"[hh]elp" -> " I'm afraid that I can't help ya much, I have to keep watching here. Better ask another dwarf here like Garabosch over there for help."
"buy" -> "I don't sell anything, as you see I'm a guard."
"sell" -> "Thanks, but I already have everything I need."
"[ww]hat.+buy" -> "Thanks, but I already have everything I need."
"[ww]hat.+sell" -> "I don't sell anything, as you see I'm a guard."
"[kk]aufen" -> "Ick verkauf' nichts, wie du siehst bin ick Torwächterin!"
"[vv]erkaufen" -> "Nay danke, ick hab' bereits alles was ick brauche."
"[ww]as.+kauf" -> "Nay danke, ick hab' bereits alles was ick brauche."
"[ww]as.+verkauf" -> "Ick verkauf' nichts, wie du siehst bin ick Torwächterin!"
english, "[gg]reenbriar" -> "Greenbriar is a settlement of the Halflings."
"[hh]arbo[u]+r" -> "Troll's Bane and Vanima both have Harbors. The one southwest from Troll's Bane is bigger though."
english, "[hh]ellbriar" -> "That was an evil dungeon near Greenbriar ! The evil Cultists there sacrificed most of the Halflings of Greenbriar."
"[mm]agic.+[aa]cademy" -> "You don't want ta go THERE ! It can only be entered by a mage, they say. They turn people into pigs or cows or worse things there!"
"[mm]age.+[aa]cademy" -> "You don't want ta go THERE ! It can only be entered by a mage, they say. They turn people into pigs or cows or worse things there!"
"[nn]orthmark" -> "it's not cooler there than elsewhere on Gobiath, except for the north wind in winter. Some Norodaj-Barbarians have settled there."
"[ss]ilverbrand" -> "Silverbrand is the name of this town, its the town of the dwarfes."
english, "[vv]anima" -> "Tol Vanima ? That's a whole small island full of trees and elves."
english, "[tt]roll['s].+[bb]ane" -> "Well, that's the biggest town on Gobiath."
english, "[vv]arshikar" -> "You find it past the small sand desert in the far northwest. I would use the Teleporter, the desert is full of scorpions."
german, "[gg]reenbriar" -> "Greenbriar is nen Halblingsdorf. Viel zu grün da wennste mich fragst."
"[hh]afen" -> "Troll's Bane und Vanima haben Häfen. Der Hafen südwestlich von Troll's Bane is aber größer."
german, "[hh]ellbriar" -> "Das war ein von einem barbarischen Kult besetzter Dungeon nahe bei Greenbriar. Die bösartigen Kultisten dort haben die meisten der armen Halblinge geopfert."
"[mm]agierakademie" -> "Du willst nicht wirklich DA hin ! Es wird gesagt, den Ort kann nur ein Magier betreten. Die verwandeln dort Leute in Schweine, Kühe oder schlimmeres !"
"[nn]ordmark" -> "Es ist da nicht kälter als anderswo auf Gobiath, abgesehen vom Nordwind im Winter. Dort haben sich einige Norodaj-Barbaren angesiedelt."
"[ss]ilberbrand" -> "Silberbrand ist der Name dieser Stadt hier, es ist die Stadt der Zwerge."
german, "[vv]anima" -> "Tol Vanima ? Das ist eine ganze kleine Insel voller Bäume und Elfen."
german, "[tt]roll['s].+[bb]ane" -> "Tja, das ist die grösste Stadt auf Gobiath. Dort leben alle Rassen, sogar ein zwei Zwerge. Aber früher oder später kommen sie alle hierher."
german, "[vv]arshikar" -> "Das findet man nicht ganz so weit von hier im Nordwesten hinter der kleinen Sandwüste. Ich würde den Teleporter benutzen, die Wüste ist voller Skorpione."
english, "[ii]rmorom" -> "The Lord of trade and craftsmenship ! He is the main god of the dwarves. Some call him the smith of the world."
german, "[ii]rmorom" -> "Der Herr des Handels und des Handwerks ! Er ist der Hauptgott des Zwergenvolkes. Manche nennen ihn auch den Weltenschmied."
german, "[ee]rz[äa][eh].+[bb]oindil.*" -> "#me grummelt 'Arrr, das is der Zwerg, der mir einst diesen Wisch von Abschiedsbrief in die Hand gedrückt hat und dann 'uff nimmer wiedersehn abgehaun' is! Früher...da war er noch schwer in Ordnung, nu weiß ick aber nich was in ihn gefahren is."
german, "[ee]rz[äa][eh].+[bb]rendil.*" -> "Mhh... von Brendil hab mir nur Geschichten gehört. Soll 'n starker Kämpfer gewesen sein - aber mit schwachem Geist. Soll irgendwann verrückt gewordn sein, wenn mir nich alles täuscht."
german, "[ee]rz[äa][eh].+[gg]loin.*", "[ee]rz[äa][eh].+[gg]lôin.*" -> "#me kratzt sich kurz nachdenklich an ihrer Schläfe \"Glôin... diesn Namen hab mir schon mal gehört... is dat nicht Brendil, dieser Taugenüscht?\""
german, "[ee]rz[äa][eh].+[gg]horn.*" -> "Was redest du von König Ghorn? Er war n' weiser und gerechter König! Ick glaub gehört zu haben, dass der die Gewölbe entdeckte, die Silberbrand mit der Menschenstadt verband. Bin mir da aber nich sicher."
german, "[tt]unnel.*", "[gg]ew[öo][le][bl][eb].*" -> "Da war mal n' starkes Beben in den Erzminen. Wir dachten schon der ganze Berg würd' einbrechen, so stark war das! Aber durch det Beben wurde ein Tunnel frei gelegt - was damit heut' is, weiß mir nicht."
german, "[rr]othman.*" -> "#me haut verärgert mit der Faust gegen die Felswand \"Hör mir 'uff mit diesem Namen! Jeder dieser Rothmans hat es verdient geteert und gefedert und dann vom höchsten Gipfel diese Berges gestürzt zu werdn. Das Geräusch vom Aufprall wär' wie Musik in meen Ohr!\""
german, "[ee]rz[äa][eh].+[rr]imni.*" -> "Och, der Rimni... auch so 'n Faulpelz! Macht viel, aber nüscht richtich! Abgesehn von senen leckren Broten! Arrr, wie von Irmorom selbst gebacken, so schmecken die!"
german, "[ee]rz[äa][eh].+[ss]asse.*" -> "#me blinzelt freudig \"Arr, wo is Sasse? Gibs was zu futtern? Kein andrer kann so leckren Rehberaten zubereiten, wie der!\""
german, "[ee]rz[äa][eh].+[aa]ndril.*" -> "#me senkt bedächtig den Kopf \"Mögest du in Frieden Ruhn, Andril! Dein leckes Zwergenbräu fehlt uns in der Kehle. Deine Bedachtheit und Weisheit würd uns in so mancher finstren Stunden helfen.\""
german, "[ee]rz[äa][eh].+[gg]oldhand.*", "[ee]rz[äa][eh].+[gg]aron.*" -> "Arrr, so ein stattlicher Zwerg, der Garon! Hat ganz schön viel erreicht, richteste ihm mal schöne Grüße von der Goldra aus? *sie zwinkert dir zu*"
german, "[ee]rz[äa][eh].+[ff]riedwulfa.*", "[ee]rz[äa][eh].+[ff]ried[el].*" -> "Die Friedel weiß noch wie man zupackt! Sie und mir sind ausm selben Stein gehaun! Legt sich jemand mit ihr an, hat ers auch mit mir zu tun! Und das rat ick keinem!"
german, "[ee]rz[äa][eh].+[gg]uran.*" -> "Sprichst grad vom Meisterschmied Guran? Wennst ne dicke, starke Rüstung brauchst ist er dein Zwerg *klopft gegen ihre Rüstung unter der Robe* das gute Stück hier ist auch von ihm."
german, "[ee]rz[äa][eh].+[tt]horwald.*" -> "Selten zuvor hab mir sonen fleissigen Zwegenkönich gesehn, wie ihn! Egal wat du brauchtest, egal in welchen Mengen: Er hatte et uff Lager!"
german, "[ee]rz[äa][eh].+[tt]horgrimm.*" -> "Thorgrimm? Arr... den seh ick hier so selten wie das Sonnenlicht! Ick glob der hockt tagein, tagaus in seiner Priesterkammer und redet zu Irmorom - hoffentlich schwafelt er dabei net zu viel, sonst wird Irmorom noch grantig."
german, "[ee]rz[äa][eh].+[ss]urian.*" -> "Mit Thorgrimm und Surian is das Schicksal der Götter uff jeden Fall auf unsrer Seite! ...wobei Bragon ja eher ein Kieselstein im Vergleich zu Irmorom ist, natürlich."
german, "[ee]rz[äa][eh].+[ii]var.*" -> "Ivar hat nich nur Kraft im Arm, sondern auch Hummeln im Hintern! So viel wie der schuftet, geht ja in keinen Zwergenbart. Da könnt sich so manch andrer Zwerg ne Scheibe oder zwei von abschneidn!"
german, "[mm]agdha.*" -> "Was is mit Magdha? Du findest sie schöner als mir? Arrr... ick gebs zu... sie hat größere Steine vor der Hütte, aber im Kampf hatse noch nie gegen mir gewonnen! *zwinkert dir zu*"
german, "[ee]rz[äa][eh].+[tt]hurbert.*" -> "Der Thurbert, ja dat war ein tüchtiger Zwerg. Als Kanzler war er 'n guter Organisator und konnte sogar mit'm Kroppzeug von oben gut reden, doch leider meinte es dat Schicksal nich gut mit ihm. Kurz nach seiner späteren Krönung  zum König erstickte er an nem Steak, Gerüchte besagen dass sein Leibkoch Salfalur damit was zu tun hatte."
german, "[ee]rz[äa][eh].+[tt]irana.*" -> "Na die Tirana hat das Herz am rechten Fleck, an der Kochstelle. Der ihr Futter ist das Allerbeste, nur noch übertroffen von ihr'm Gebräu, vor allem det Bier."
german, "[ee]rz[äa][eh].+[ff]erin.*" -> "Tja, über Ferin, den Bruder Altkönig Thorwalds kann ich nich viel sagen. Zu selten bekam man ihn zu Gesicht aber wenn er da war, dann richtig und für alle!"
german, "[ee]rz[äa][eh].+[tt]hanseus.*" -> "Er is'n junger un' ungeduldiger Bruder, nen bissl grün hinter den Ohren is er auch. Aber ein Zwerg sollte wie er einer sein, immer gemeinschaftlich und hilfsbereit."
german, "[ee]rz[äa][eh].+[bb]alduin.*" -> "Der Balduin, jau, nen fleißiger angehender Goldschmied. Hat schon beim ein oder andern' Auftrag wat mitgearbeitet. Ganz am Anfang war er noch Bürger von Trollsbane als er sein' Eid abgelegt hat. Heut' aber nimmer."
german, "[ee]rz[äa][eh].+[tt]rokamm.*" -> "Der ist ziemlich launisch, der Trokamm. Manchmal strengt er sich richtich an bei der Arbeit dann liegt er nur mehr auffer faulen Haut. Er war wo er herkommt mal König, behauptet er immer."
german, "[ee]rz[äa][eh].+[bb]althor.*" -> "Der Balthor gehört zu den Meisterschmieden Silberbrands, ich hab mal gehört dass er 'Balthor Pinnhand' heißt weil er mal in ner' Taverne die anbot \"Zahl 30 Münzen und fülle deinen Krug so oft du willst\" selbige Taverne fast bankrottgesoffen hat. Als er unter Protest den Krug abgeben sollte hat er ihn sich einfach an die Hand ge-pinnt"
german, "[ee]rz[äa][eh].+[aa]mrothar.*" -> "Amrothar, ja klar, der is'n alter Schürfer. Ist unser Kanzler und hat mal Silberbrand geführt als Friedl ne Weile weg war."
"[ee]rz[äa][eh].+[mm]anron.*", "[ee]rz[äa][eh].+[kk][öo][ne][in][gi].*", "[ee]rz[äa][eh].+[kk][öo][ne][in][ci][hc].*" -> "Der Manron ist einer der Altkönige, wenn er mal nich am Goldschmieden ist, dann ist er in den Minen schürfen - so wie es sich für nen Zwergen gehört!"
german, "[bb]ier.*" -> "#me hebt den Krug und prostet in die Runde 'Wer viel rumsteht, muss viel trinken - Alte Torwächterweisheit!'"
german, "[tt]orwächter.*" -> "Jetzt fang bloß nich damit an, über meine Aufgabe zu meckern! Ohne uns und dat Tor wär Silberbrand schon ein dutzend Mal eingenommen worden!"
german, "[tt]or.*" -> "Aye, jeden Tag und jede Stund' steh ick da draussen am Tor - haste gewusst, dass da mindestens fuffzich Bäume drin verbaut sind? Von den Mengen an Nägeln ganz zu schweigen, aber schlussendlich ists n' Meisterstück geworden."
"[dd]unkel.*", "[dd]üster.*" -> "Wie? Du findest es dunkel hier? Dann schneid' dir mal die Haare und mach die Augen richtig uff'! Du meckerst ja fast so viel wie Trokamm, wenn er mal wieder zum Training muss!"

-- Migration follow-up
-- Custom Lua functions require review: nextCycleDisabled, mainTask, standardAnswer, keinBock, wait, checkGender, drinkBeer, drinkGame, hicks, moveFunction, isPassable, tellJoke, initJoke
-- Custom event dispatch outside registration rules requires review.
-- Movement, spawning or world changes require Lua hooks.
