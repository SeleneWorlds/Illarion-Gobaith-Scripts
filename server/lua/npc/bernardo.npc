-- Derived from old/bernardo.lua; UTF-8.
-- Archived Lua remains the reference for custom behavior.
name = "Bernardo von Hochfels"
race = human
sex = male
position = -87, -123, 1
direction = south
language = common
language = human
defaultLanguage = common
autointroduce = on
useMsgDE = "Finger weg!"
useMsgUS = "Don't you touch me!"


"[tt]ax", "[ss]teuer" -> lua("npc.custom.tax_collector", "collect", "trollsbane")
"what.+day.+today", "what.+today.+day", "what.+date", "welch.+tag.+heute", "was.+tag.+heute", "was.+datum", "welch.+datum" -> lua("npc.custom.calendar", "date")

"[gg]reetings", "[hh]ello" -> "Greetings. Can i help you?", "Be greeted. I'm %NPCNAME. Can I help you?"
"[gg]rü[ßs]+e", "[hh]allo" -> "Grüße. Kann ich euch helfen?", "Guten Tag. Ich bin %NPCNAME. Kann ich euch helfen?"
"[yy]ou.+[tt]rader" -> "No. I'm no trader. I'm the tax collector of Trollsbane."
"[ddii][uh]r*.+[hh]ändler" -> "Nein ich bin kein Händler. Ich bin der Steuerneintreiber von Trollsbane."
"[ww]hat.+sell" -> "Nothing. I'm no trader so i sell nothing."
"[ww]as.+verkauf" -> "Ich bin kein Händler also verkaufe ich auch nichts."
"[tt]ell.+[ss]omething" -> "What shall I tell you? Tell me what you want or leave. But do not waste my time."
"[ee]rzähl.+[ww]as" -> "Was soll ich euch erzählen? Sagt mir was ihr wollt, aber verschwendet meine Zeit nicht."
"[gg]oodbye", "[bb]ye", "[ff]arewell" -> "Be well.", "Farewell!", "Good bye."
"[aa]uf.+[bb]ald", "[bb]is.+[bb]ald" -> "Auf wiedersehen.", "Auf bald"
