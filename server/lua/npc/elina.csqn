use: german -> "Fasst mich nicht an!"
use: english -> "Don't you touch me!"

cycle: pick(
    if(german, "#me schnitzt mit eleganten Bewegungen an einer kleinen Holzstatue herum", "#me carves on a small wooden statue with a elegant motions"),
    if(german, "#me blickt sich kurz um", "#me looks around a moment"),
    if(german, "#me betrachtet einen Pfeil prüfend", "#me looks on an arrow with a checking glance"),
)

chat: match(
    "[gg]reetings",
    "[hh]ello",
) -> pick(
    "The five with you. Can I help you?",
    "Be blessed, my friend. Do you need something?",
)

chat: match("[yy]ou.+[tt]rader") -> "I am a trader, yes. I trade different carpentry tools."

chat: match("[ww]hat.+sell") -> "I sell all kinds of carpentry tools"

chat: match("[ww]hat.+[tt]ools") -> "I sell tools for carpenters. Saws, axes, planes and carving tools."

chat: match("[tt]ell.+[ss]omething") -> "This is Tol Vanima, the home of us elves."

chat: match(
    "[gg]oodbye",
    "[bb]ye",
    "[ff]arewell",
) -> pick(
    "The five with you!.",
    "May the gods bless your path!",
    "Farewell, my friend!",
)

chat: match("[ww]hat.+buy") -> "I buy all kinds of bows and crossbows."

chat: match("[ww]ho.+you?") -> "My name is Elinas."

chat: match("i'm.+.+") -> "Be greeted!"

chat: match("[hh]elp") -> "'List your wares', 'I want to buy <number> <wares>', 'I want to buy a <ware>', 'I want to sell <number|a> <wares>', 'Price of ...','What do you pay for ...', 'What wares do you buy?'"

chat: match(
    "[gg]r[üu][ßs]+",
    "[hh]allo",
) -> pick(
    "Die Fünf zum Gruße, kann ich euch helfen?",
    "Möge euer Pfad gesegnet sein! Wie kann ich euch helfen?",
)

chat: match("[ddii][uh]r*.+[hh]ändler") -> "Ich bin ein Händler, ja, und ich verkaufe unter anderem Werkzeuge."

chat: match("[ww]as.+verkauf") -> "Ich verkaufe Werkzeuge für jede Art von Tischlerei."

chat: match("[ww]as.+[ww]erkzeug") -> "Nun, ich verkaufe Tischlerwerkzeug...Sägen, Äxte, Hobel und Schnitzwerkzeuge."

chat: match("[ee]rzähl.+[ww]as") -> "Dies ist Tol Vanima, die Heimat von uns Elfen."

chat: match(
    "[aa]uf.+[bb]ald",
    "[bb]is.+[bb]ald",
) -> pick(
    "Die Fünf seien mit euch. Bis bald!",
    "Bis bald, mein Freund, der Segen der Fünf mit euch!",
)

chat: match("[ww]as.+%s[kk]auf") -> "Ich kaufe alle Arten von Bögen und Armbrüsten."

chat: match("[ww]er.+[iidd][hu]r*") -> "Ich bin Elinas."

chat: match("ich.+bin.+.+") -> "So grüße ich euch, mein Freund!"

chat: match("[hh]ilfe") -> "'Welche Waren verkauft ihr', 'Ich möchte <Anzahl> <Ware> kaufen', 'Ich möchte <Ware> kaufen', 'Ich möchte <Anzahl> <Ware> verkaufen', 'Was ist der Preis von <Ware>','Was zahlt ihr für <Ware>', 'Was kauft ihr?'"

chat: chatTrading("elina")
