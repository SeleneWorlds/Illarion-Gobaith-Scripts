"[gg]reetings", "[hh]ello" -> "Welcome. How can I help you?", "Good day. Do you need something? I have cheap wares!"
"[gg]rü[sß]+e", "[hh]allo" -> "Willkommen. Kann ich euch helfen?", "Guten Tag? Braucht ihr etwas? Ich habe billige Waren"
"[yy]ou.+[tt]rader" -> "A trader I am, that's right. I trade different kinds of wares."
"[ddii][uh]r*.+[hh]ändler" -> "Ich bin Händler, das ich richtig. Ich handel mit verschiedensten Waren."
"[ww]hat.+sell" -> "I sell mostly smithed weapons."
"[ww]as.+verkauf" -> "Ich verkaufe geschmiedete Waffen."
"[tt]ell.+[ss]omething" -> "Once upon a time, I came here. Now I am here. Isn't that interesting?"
"[ee]rzähl.+[ww]as" -> "Vor langer Zeit, kam ich hier her. Jetzt bin ich da. Ist das nicht interessant?"
"[gg]oodbye", "[bb]ye", "[ff]arewell" -> "Have a nice day.", "Farewell!", "Good bye."
"[aa]uf.+[bb]ald", "[bb]is.+[bb]ald" -> "Schönen Tag.", "Auf bald"
"[ww]ho.+you?" -> "My name is %NPCNAME."
"[ww]er.+[ddii][uh]r*" -> "Mein Name ist %NPCNAME."
"i'm.+.+" -> "Nice to meet you."
"[ii]ch.+[bb]in" -> "Freut mich euch kennen zu lernen"
"[hh]elp" -> "'List your wares', 'I want to buy <number> <wares>', 'I want to buy a <ware>', 'I want to sell <number|a> <wares>', 'Price of ...','What do you pay for ...', 'What wares do you buy?'"
"[hh]ilfe" -> "'Welche Waren verkauft ihr', 'Ich möchte <Anzahl> <Ware> kaufen', 'Ich möchte <Ware> kaufen', 'Ich möchte <Anzahl> <Ware> verkaufen', 'Was ist der Preis von <Ware>','Was zahlt ihr für <Ware>', 'Was kauft ihr?'"

-- Open the trading menu.
"trade", "buy", "sell", "wares", "handel", "kauf", "verkauf", "waren" -> trade
