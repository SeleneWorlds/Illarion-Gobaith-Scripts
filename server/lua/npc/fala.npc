-- Derived from npc/fala.lua; UTF-8.

name = "Fala"
race = human
sex = female
position = -96, -116, 0
direction = south
language = common
language = human
language = lizard
defaultLanguage = common
autointroduce = on
useMsgDE = "Fasst mich nicht an!"
useMsgUS = "Don't you touch me!"
wrongLangDE = "#me sieht dich leicht verwirrt an"
wrongLangUS = "#me looks at you a little confused"

german, "[gg]rü.+", "[hh]allo", "[gg]uten.+tag" -> "Die Fünf mit euch. Ihr seht ratlos aus, braucht ihr Hilfe?"
english, "[gg]reet", "[hh]ello", "[gg]ood.+day" -> "The Five be with you. You look puzzled. Do you need help?"
german, "[hh]ilfe" -> "Nun, ich kann euch einiges erzählen über: Gobaith, die Städte, die Götter, die Rassen und die Sehenswürdigkeiten"
english, "[hh]elp" -> "Well, I can tell you about Gobaith, its towns, the gods, the races and the sights."
german, "[gg]obaith", "[ii]nsel" -> "Gobaith ist die Insel auf der ihr euch befindet, es gibt einige Siedlungen hier und viele Orte die sehr sehenswert sind"
english, "[gg]obaith", "[ii]sland" -> "Gobaith is the island you are on. There are several settlements here and many places worth seeing."
german, "[ss]tädte", "[ss]iedlungen" -> "Da gibt es einmal Trollsbane, Silberbrand, Varshikar, Greenbriar und natürlich Tol Vanima"
english, "[tt]owns", "[cc]ities", "[ss]ettlements" -> "There are Trollsbane, Silverbrand, Varshikar, Greenbriar and, of course, Tol Vanima."
german, "[ss]ilberbrand" -> "Silberbrand ist die Stadt der Zwerge, verlasst die Stadt durch das Osttor und folgt der Straße nach Osten, der Weg ist beschildert."
english, "[ss]ilverbrand", "[ss]ilberbrand" -> "Silverbrand is the town of the dwarves. Leave town through the eastern gate and follow the road east. The way is signposted."
german, "[vv]arshikar" -> "Varshikar ist eine kleinere Siedlung in den Bergen, geht durch das Osttor nach Osten und haltet euch auf dem Weg, passt auf Räuber, Fliegen und Skorpione auf"
english, "[vv]arshikar" -> "Varshikar is a smaller settlement in the mountains. Head east through the eastern gate and stay on the path. Watch out for bandits, flies and scorpions."
german, "[rr]äuber" -> "Wegelagerer die euch ohne Zögern töten könnten! Sie lagern bekanntlich im Wäldchen zwischen Silberbrand und Varshikar und im und um den Nordwald herum."
english, "[bb]andits", "[rr]obbers" -> "Highwaymen who could kill you without hesitation! They are known to camp in the woods between Silverbrand and Varshikar, and in and around the northern forest."
german, "[ss]korpione" -> "Ihr Stich ist extrem giftig! Sie leben in der Wüste zwischen Silberbrand und Varshikar, seid vorsichtig wenn ihr sie seht!"
english, "[ss]corpions" -> "Their sting is extremely poisonous! They live in the desert between Silverbrand and Varshikar. Be careful if you see them!"
german, "[ff]liegen" -> "Eher lästige Biester, aber unterschätzt sie nicht! Ihr trefft sie am ehesten in der Nähe von Sümpfen."
english, "[ff]lies" -> "Annoying beasts, but do not underestimate them! You are most likely to encounter them near swamps."
german, "[gg]reenbriar" -> "Eine Halblingssiedlung auf einer Insel südwestlich von hier. Verlasst die Stadt durch das Westtor und folgt der Straße und den Wegweisern "
english, "[gg]reenbriar" -> "A halfling settlement on an island southwest of here. Leave town through the western gate and follow the road and the signposts."
german, "[tt]ol.+[vv]anima" -> "Tol Vanima ist die Insel der Elfen. Ihr erreicht sie per Schiff vom Hafen aus. Es ist Unsitte dort Waffen zu tragen!"
english, "[tt]ol.+[vv]anima" -> "Tol Vanima is the island of the elves. You can reach it by ship from the harbor. Carrying weapons there is considered rude!"
german, "[oo]rte", "[ss]ehenswürdigkeiten", "[pp]lätze" -> "Nun, Lake Adron, die Burg der Grauen, die drei Schwestern, das Druidenhaus, und der Hafen sind einige interessante Orte"
english, "[pp]laces", "[ss]ights" -> "Well, Lake Adron, the castle of the Grey Rose, the Three Sisters, the druid house and the harbor are some interesting places."
german, "[ll]ake.+[aa]dron" -> "Der See hat seinen Namen vom Gott Adron und begrenzt Trollsbane im Osten, ein hübsches Plätzchen."
english, "[ll]ake.+[aa]dron" -> "The lake is named after the god Adron and borders Trollsbane to the east. A lovely spot."
german, "[bb]urg" -> "Die Burg erhebt sich nördlich von Trollsbane und wacht über die umliegende Landschaft, ein beeindruckendes Bauwerk. "
english, "[cc]astle" -> "The castle stands north of Trollsbane and watches over the surrounding countryside. An impressive building."
german, "[dd]rei.+[ss]chwestern" -> "Die drei Schwestern oder Inseln der Sirani sind Gobaith vorgelagert. Eine Fähre pendelt vom Hafen aus dort hin. Ein wirklich romantischer Ort..."
english, "[tt]hree.+[ss]isters", "[ss]irani.+[ii]slands" -> "The Three Sisters, or Islands of Sirani, lie off Gobaith. A ferry travels there from the harbor. A truly romantic place..."
german, "[dd]ruidenhaus" -> "Das Druidenhaus ist ein Ort für Druiden, die Pflanzen und die Heilkunst studieren."
english, "[dd]ruid.+[hh]ouse" -> "The druid house is a place for druids who study plants and the healing arts."
german, "[tt]rollsbane" -> "Trollsbane ist die älteste Menschensiedlung der Insel. Sie liegt sehr zentral und ist auch die größte Stadt. Ach ja, und ihr steht mitten in ihr, braucht ihr eine Stadtübersicht?"
english, "[tt]rollsbane", "[tt]roll.*[bb]ane" -> "Trollsbane is the oldest human settlement on the island. It is centrally located and is also the largest town. Oh, and you are standing right in it. Would you like an overview of the town?"
german, "[ss]tadtübersicht" -> "Es gibt viele Gebäude hier: Die Stadttore, das Seahorse Inn, die Taverne, die Bücherei, die Werkstatt, das Gefängnis, das Krankenhaus, der Laden"
english, "[tt]own.+[oo]verview", "[cc]ity.+[oo]verview" -> "There are many buildings here: the town gates, the Seahorse Inn, the tavern, the library, the workshop, the prison, the hospital and the shop."
german, "[ss]tadttore" -> "Nun die Tore sind keine Gebäude an sich aber durch sie könnt ihr die Stadt verlassen, es gibt ein Nordtor, ein Osttor und ein Westtor"
english, "[tt]own.+[gg]ates", "[cc]ity.+[gg]ates" -> "The gates are not buildings as such, but you can leave town through them. There is a northern, an eastern and a western gate."
german, "[ss]eahorse.+inn" -> "Wenn ihr eine Bleibe sucht, seid ihr hier richtig! Es ist ein großes mehrstöckiges Haus am Westtor, gleich neben Lake Adron, ihr könnt es nicht verfehlen!"
english, "[ss]eahorse.+inn" -> "If you are looking for a place to stay, this is it! It is a large building with several floors by the western gate, right next to Lake Adron. You cannot miss it!"
german, "[tt]averne" -> "Die Fluffy Sheep Taverne ist gleich auf der anderen Straßenseite dieses Gebäudes. Der Barkeeper ist ruppig, aber die Getränke sind gut und preiswert."
english, "[tt]avern" -> "The Fluffy Sheep Tavern is just across the street from this building. The barkeeper is gruff, but the drinks are good and affordable."
german, "[bb]ücherei" -> "Ihr befindet euch in der Bücherei. Dieser Schrein ist Elara gewidmet."
english, "[ll]ibrary" -> "You are in the library. This shrine is dedicated to Elara."
german, "[ww]erkstatt" -> "Die Werkstatt ist gleich östlich vom Seahorse Inn. In der Werkstatt findet ihr sperriges Werkzeug für manches Handwerk."
english, "[ww]orkshop" -> "The workshop is just east of the Seahorse Inn. It contains large tools for various crafts."
german, "[gg]efängnis" -> "Hofft dass ihr es nie von innen sehen müsst! Es ist etwas westlich vom Nordtor."
english, "[pp]rison", "[jj]ail" -> "Hope you never have to see it from the inside! It is a little west of the northern gate."
german, "[kk]rankenhaus" -> "Das Krankenhaus liegt zwischen Taverne und Seahorse Inn. Dort könnt ihr Kräuter und Heiltränke erstehen und behandelt werden sollte ein Heiler präsent sein."
english, "[hh]ospital" -> "The hospital is between the tavern and the Seahorse Inn. You can buy herbs and healing potions there and receive treatment if a healer is present."
german, "[ll]aden" -> "Zum Laden kommt ihr wenn ihr der Straße draußen Richtung Osten folgt. Eliza verkauft Waffen, die anderen Händler Kleidung und Gemischtwaren."
english, "[ss]hop" -> "Follow the road outside to the east to reach the shop. Eliza sells weapons, and the other traders sell clothes and general goods."

-- Idle dialogue
cycletext "#me schaut sich um", "#me looks around"
cycletext "#me murmelt ein Gebet in sich hinein", "#me murmurs a prayer to herself"
