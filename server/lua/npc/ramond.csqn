use: german -> "Finger weg!"
use: english -> "Don't you touch me!"

chat: match(
    "[hh]ello",
    "[gg]reetings",
) -> pick(
    "Greetings my friend.",
    "A pleasure to meet you, friend.",
)

chat: match(
    "[hh]allo",
    "[gg]rü[sß]+e",
) -> pick(
    "Grüße mein Freund.",
    "Ist mir eine Freude euch zu treffen.",
)

chat: match("[jj]ob") -> "I take care of this graveyard"

chat: match("[bb]eruf") -> "Ich kümmere mich um diesen Friedhof"

chat: match("[gg]ravejard") -> "This is the place where everybody finds the eternal sleep."

chat: match("[ff]riedhof") -> "Das ist der Ort wo jeder seine ewige Ruhe finden kann."

chat: match("[mm]ission") -> "My friend, I am a simple man with no needs."

chat: match("[aa]uftrag") -> "Mein Freund, ich bin ein einfach Mann der nichts braucht."

chat: match("[qq]uest") -> "My friend, I am a simple man with no needs."

chat: match("[nn]eed.+help") -> "All you could do for me, is helping me with the garden work. Like taking care of the graves."

chat: match("[bb]rauch.+[hh]ilfe") -> "Alles was ihr für mich tun könntet, ist mir bei der Garten Arbeit zu helfen. Zum Beispiel könntet ihr euch etwas um die Gräber kümmern."

chat: match("[gg]rave") -> "I take care of them as good as I can, but sometimes they even scare me."

chat: match("[gg]r[aä]b") -> "Ich kümmere mich um sie, so gut ich kann, aber machmal erschrecken sie mich."

chat: match("[ss]care") -> "During these nights without moon, I could swear that a body left a grave and walked away!"

chat: match("[ss]reck") -> "Während der Nächte ohne Mond, könnte ich schwören das ein Körper sein Grab verlassen hat und weg gelaufen ist!"

chat: match("[ww]hat.+sell") -> "I cannot offer you much, only maybe one of my old shovels."

chat: match("[ww]as.+verkaufen") -> "I kann nicht viel Anbieten. Allerhöchstens vielleicht meine alten Schaufeln."

chat: match("[ww]hat.+buy") -> "I fear, my friend, that there is nothing I would want to buy right now."

chat: match("[ww]as.+%skauf") -> "Ich fürchte, mein Freund, es gibt nichts was ich im Augenblick von euch kaufen würde."

chat: match("[ww]ho.+[yy]ou") -> "I am Brother Ramond"

chat: match("[ww]er.+[ddii][uh]r*") -> "Ich bin Bruder Ramond"

chat: match(
    "[dd]ungeon.+below.+[gg]raveyard",
    "[tt]empel.+below.+[gg]raveyard",
) -> pick(
    "What!? I know nothing about it.",
    "What!? I know nothing about it.",
)

chat: match(
    "[hh]öhle.+unter.+[ff]riedhof",
    "[tt]empel.+unter.+[ff]riedhof",
) -> pick(
    "Was? Davon weis ich nichts.",
    "Was?! Davon wüsste ich doch!",
)

chat: match(
    "[bb]ye",
    "[ff]are.*well",
) -> pick(
    "Walk in peace, my friend.",
    "Walk in peace, my friend.",
)

chat: match(
    "[aa]uf.+[bb]ald",
    "[bb]is.+[bb]ald",
) -> pick(
    "Geh in Frieden, mein Freund.",
    "Geh in Frieden, mein Freund.",
)

chat: match("[hh]elp") -> "'List your wares', 'I want to buy <number> <wares>', 'I want to buy a <ware>', 'I want to sell <number|a> <wares>', 'Price of ...','What do you pay for ...', 'What wares do you buy?'"

chat: match("[hh]ilfe") -> "'Welche Waren verkauft ihr', 'Ich möchte <Anzahl> <Ware> kaufen', 'Ich möchte <Ware> kaufen', 'Ich möchte <Anzahl> <Ware> verkaufen', 'Was ist der Preis von <Ware>','Was zahlt ihr für <Ware>', 'Was kauft ihr?'"

chat: chatTrading("ramond")
