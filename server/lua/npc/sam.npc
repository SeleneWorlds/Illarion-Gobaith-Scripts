"[gg]reetings", "[hh]ello" -> "Indeed. Greetings. Who are you?", "Hello. How may I help you?"
"[hh]allo", "[gg]r[uü][sß]+" -> "Hallo. Kann ich euch vielleicht helfen?", "In der Tat. Grüße. Wie geht es euch?"
"[yy]ou.+[tt]rader" -> "Yes, I am a trader. What can I get you?"
"[ddii][uh]r*.+[hh][äa]ndler" -> "Ja. Ich bin ein Händler. Kann ich etwas für euch besorgen?"
"[ww]hat.+sell" -> "I sell clothes, tools and more."
"[ww]as.+verkauf" -> "Ich verkaufe Kleidung, Werkzeug und mehr."
"[ww]hat.+[cc]loth" -> "I sell farmer hats, shirts, trousers, capes, gloves, shoes and boots and leather armor."
"[ww]as.+[kk]leidung" -> "Ich verkaufe Schlapphüte, Hemden, Hosen, Umhänge, Handschuhe, Schuhe, Stiefel und Lederrüstungen."
"[ww]hat.+[tt]ool" -> "I sell needles and scissors, saws, shovels, axes hammers and glass blowing pipes."
"[ww]as.+[ww]erkzeug" -> "Ich verkaufe Nadeln und Scheren. Sägen und Schaufeln. Äxte und Hammer. Und Glasblasrohre."
"[ww]hat.+[mm]ore" -> "I have some empty bottles for sale."
"[ww]as.+[mm]ehr" -> "Ich habe einige leere Flaschen zum Verkauf."
"[bb]ye.", "[ff]are.+well" -> "Aye. Good day to you", "Aye! Good day."
"[aa]uf.+[bb]ald", "[bb]is.+[bb]ald" -> "Bis bald!", "Kommt doch noch einmal! Ich habe immer die besten Waren"
"[hh]elp" -> "'List your wares', 'I want to buy <number> <wares>', 'I want to buy a <ware>', 'I want to sell <number|a> <wares>', 'Price of ...','What do you pay for ...', 'What wares do you buy?'"
"[hh]ilfe" -> "'Welche Waren verkauft ihr', 'Ich möchte <Anzahl> <Ware> kaufen', 'Ich möchte <Ware> kaufen', 'Ich möchte <Anzahl> <Ware> verkaufen', 'Was ist der Preis von <Ware>','Was zahlt ihr für <Ware>', 'Was kauft ihr?'"

-- Open the trading menu.
"trade", "buy", "sell", "wares", "handel", "kauf", "verkauf", "waren" -> trade
