-- Derived from npc/jarmal.lua; UTF-8.

name = "Jarmal"
race = human
sex = male
position = -286, 46, 0
direction = south
job = "Speaker"
language = common
language = human
defaultLanguage = common
autointroduce = on
useMsgDE = "Finger weg!"
useMsgUS = "Don't you touch me!"
wrongLangDE = "#me sieht dich leicht verwirrt an"
wrongLangUS = "#me looks at you a little confused"

german, "[tt]roll'*s.*[bb]ane" -> "Aye, Trollsbane im Nordosten. Du kannst eigentlich alles doch finden."
english, "[tt]roll'*s.*[bb]ane" -> "Aye, Trollsbane in the Northeast. You can find practically everything there."
german, "[gg]reen.*[bb]riar" -> "Früher war es mal ein Halblingsdorf, jetzt sollen dort aber nur noch Elfen leben."
english, "[gg]reen.*[bb]riar" -> "This used to be a Halfling village, now only some elves live here."
"[hh]ello", "[gg]reetings" -> "Greetings Traveler, I hope you had a pleasant voyage.", "Ah, Greetings Landrat. Was the journey rough?"
"[hh]allo", "[gg]r[uü][sß]+" -> "Grüße Reisender, ich hoff du hattest ne angenehme Reise.", "Ah, Grüße Landratte. War die Reise rau?"
"[ww]ho" -> "I am %NPCNAME, shipboy."
"[ww]er" -> "Ich bin %NPCNAME, Schiffsjunge."
"[ww]here.+a[mr]e*" -> "This is the harbour, where else did you expect a ship to bring you?"
"[ww]o.+[sb]ind*" -> "Das ist der Hafen. Wo sonst dachtest du bringt dich 'n Schiff hin?"
"[hh]arbour" -> "Not as big as one would expect, right? But it does the job still."
"[hh]afen" -> "Nicht so groß wie du dachtest, richtig? Aber er dient seinem Zweck."
"[tt]own" -> "The next big Town is Trollsbane, to the northeast. Or the village Greenbriar to the west."
"[ss]t[aä]dt" -> "Die nächste große Stadt ist Trollsbane im Nordosten. Oder das Dorf Greenbriar im Westen."
"[ww]hat.+sell" -> "I aint selling anything, landrat."
"[ww]as.+verkauf" -> "Ich verkauf nix, Landratte."
"[ww]hat.+buy" -> "Do I look like some filthy rich trader, landrat?"
"[ww]as.+%skauf" -> "Seh ich aus wie'n reicher Händler, Landratte?"
"[hh]elp" -> "Best advice I can give you, go somewhere else."
"[hh]ilfe" -> "Der beste Tipp, den ich dir geben kann, ist woanders hin zu gehen"
"[ss]omewhere.+else" -> "Like Trollsbane, or Greenbriar."
"[aa]nders" -> "Wie Trolls Bane oder Greenbriar."
"[nn]ew.+here" -> "I thought so the first time I saw you. Well, welcome on this little godforsaken island, landrat."
"[nn]eu.+hier" -> "Das wusst ich schon als ich dich das erste Mal gesehen hab. Naja...willkommen auf dieser kleinen Insel, Landratte."
"[ii]sland" -> "Yes, welcome on the island of ... of ... arr, forget it. Have some ale with you?"
"[ii]nsel" -> "Ja. Willkommen auf der Insel...ähm...arr, ich habs vergessen. Hast du Bier dabei?"
"[bb]ye.", "[ff]arewell" -> "Aye, Landrat.", "Aye aye."
"[aa]uf.+[bb]ald", "[bb]is.+[bb]ald" -> "Aye, Landratte", "Aye aye"
