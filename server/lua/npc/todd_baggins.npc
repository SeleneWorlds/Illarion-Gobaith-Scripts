"[gg]reetings", "[hh]ello" -> "Hi ho, friend! Do you need something?", "Good day! Is there something you need?"
"i'm.+.+" -> "Oh! A pleasure, friend."
"[ww]ho.+you?" -> "I'm %NPCNAME ! I live here in Greenbriar with the other halflings. Wouldn't want to live anywhere else at all!"
"[tt]ell.+[ss]omething" -> "If you ever go picking 'shrooms in the forest, be sure to look out for fireflies! I hear the tiny fairies ride on those."
"[gg]oodbye", "[ff]arewell" -> "Buh-bye, friend! Come around Greenbriar again when you can."
"[hh]elp" -> "'List your wares', 'I want to buy <number> <wares>', 'I want to buy a <ware>', 'I want to sell <number|a> <wares>', 'Price of ...','What do you pay for ...', 'What wares do you buy?'"
"[gg]rü[ßs]+e", "[hh]allo" -> "Grüß' dich!", "Hiho!"
"[ww]er.+[ddii][uh]r*" -> "Ich bin %NPCNAME! Ich leb hier in Greenbriar mit den anderen Halblingen. Und würd nicht um alles in der Welt hier weggehen!"
"[ee]rzähl.+[ww]as" -> "Wenn du jemals in den Wald gehst und Pilze sammelst, pass auf Leuchtkäfer auf. Ich hab gehört das Feen auf denen reiten."
"[aa]uf.+[bb]ald", "[bb]is.+[bb]ald" -> "Du gehst schon? Ach schade... Na, dann mach's mal gut!", "Ich hoffe, du kommst mal wieder vorbei!"
"[ww]er.+du?" -> "Ich werde %NPCNAME genannt."
"ich.+bin.+.+" -> "Huhu! Schön, dich kennenzulernen!"
"[hh]ilfe" -> "'Welche Waren verkauft ihr', 'Ich möchte <Anzahl> <Ware> kaufen', 'Ich möchte <Ware> kaufen', 'Ich möchte <Anzahl> <Ware> verkaufen', 'Was ist der Preis von <Ware>','Was zahlt ihr für <Ware>', 'Was kauft ihr?'"

-- Open the trading menu.
"trade", "buy", "sell", "wares", "handel", "kauf", "verkauf", "waren" -> trade
