-- Derived from old/kurg.lua; UTF-8.
-- Archived Lua remains the reference for custom behavior.
name = "Kurg"
race = orc
sex = male
position = 183, -447, 1
direction = south
language = common
language = human
defaultLanguage = common
autointroduce = on
useMsgDE = "Finger weg!"
useMsgUS = "Don't you touch me!"

sellItem = id(553), price(2), stack(1), quality(3), durability(33)
buyPrimaryItem = id(553), price(1)
sellItem = id(2934), price(2), stack(1), quality(3), durability(33)
buyPrimaryItem = id(2934), price(1)
sellItem = id(552), price(2), stack(1), quality(3), durability(33)
buyPrimaryItem = id(552), price(1)
sellItem = id(307), price(2), stack(1), quality(3), durability(33)
buyPrimaryItem = id(307), price(1)
sellItem = id(306), price(3), stack(1), quality(3), durability(33)
buyPrimaryItem = id(306), price(2)
sellItem = id(2940), price(3), stack(1), quality(3), durability(33)
buyPrimaryItem = id(2940), price(2)
sellItem = id(3051), price(3), stack(1), quality(3), durability(33)
buyPrimaryItem = id(3051), price(2)

"was.+verkaufe", "[ww]as.+verkauf" -> "Ich verkaufe alle Arten von Fleisch: Kaninchen, Lamm, Rehe und Schweinefleisch für nur 2 Kupfer jeder. Schinken, Steak und Würste kosten 3 jeder.", trade_buy
english, "what.+sell", "[ww]hat.+sell", "[dd]o%s+you%s+sell%f[^%w]" -> "Meh sells all kinds ob meats: Rabbit, Lamb, Deer and Pork for only 2 coppers each.  Ham, Steak and sausages cost 3 each.", trade_buy
"was.+kaufe", "[ww]as.*%s[kk]auf" -> "Ich kaufe alle Arten von Fleisch: Kaninchen, Lamm, Rehe und Schweinefleisch für nur 1 Kupfer jeder. Schinken, Steak und Würste sind 2 jeder wert.", trade_sell
english, "what.+buy", "[ww]hat.+buy", "[dd]o%s+you%s+buy%f[^%w]" -> "Meh buys all kinds ob meats: Rabbit, Lamb, Deer and Pork for only 1 copper each.  Ham, Steak and Sausages are worth 2 each.", trade_sell
german, "gr[üue]+[sß]+e", "hallo", "guten.+tag" -> "Schön dich zu sehen! Wie gehts dir?  Ich bin Kurg der Metzger. Wie kann ich Ihnen helfen?"
english, "greetings", "hello" -> "Greebas! How are joo?  Meh is Kurg da Butcher.  How may meh help joo?"
"auf.+bald", "bis.+bald", "tschüss" -> "Bis bald!"
"farewell", "bye", "good.+day" -> "Farrebas!"

"trade", "wares", "handel", "waren" -> trade
"sell", "verkauf" -> trade_sell
"buy", "kauf" -> trade_buy

-- Idle dialogue
cycletext "#me sieht sich für Kunden um", "#me looks around for customers"
cycletext "#me haut etwas Fleisch ab und hängt es ", "#me chops up some meat and hangs it"
