german, "gr[üue]+[sß]+e", "hallo", "guten.+tag" -> "Schön dich zu sehen! Wie gehts dir?  Ich bin Kurg der Metzger. Wie kann ich Ihnen helfen?"
english, "greetings", "hello" -> "Greebas! How are joo?  Meh is Kurg da Butcher.  How may meh help joo?"
"was.+verkaufe" -> "Ich verkaufe alle Arten von Fleisch: Kaninchen, Lamm, Rehe und Schweinefleisch für nur 2 Kupfer jeder. Schinken, Steak und Würste kosten 3 jeder."
english, "what.+sell" -> "Meh sells all kinds ob meats: Rabbit, Lamb, Deer and Pork for only 2 coppers each.  Ham, Steak and sausages cost 3 each."
"was.+kaufe" -> "Ich kaufe alle Arten von Fleisch: Kaninchen, Lamm, Rehe und Schweinefleisch für nur 1 Kupfer jeder. Schinken, Steak und Würste sind 2 jeder wert."
english, "what.+buy" -> "Meh buys all kinds ob meats: Rabbit, Lamb, Deer and Pork for only 1 copper each.  Ham, Steak and Sausages are worth 2 each."
"auf.+bald", "bis.+bald", "tschüss" -> "Bis bald!"
"farewell", "bye", "good.+day" -> "Farrebas!"

"trade", "buy", "sell", "wares", "handel", "kauf", "verkauf", "waren" -> trade

-- Idle dialogue
cycletext "#me sieht sich für Kunden um", "#me looks around for customers"
cycletext "#me haut etwas Fleisch ab und hängt es ", "#me chops up some meat and hangs it"
