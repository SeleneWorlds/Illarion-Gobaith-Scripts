name = "Magister Winfried Birks"
race = human
sex = male
position = 261, -317, -3
direction = east
language = common
language = human
language = ancient
defaultLanguage = common
autointroduce = on
useMsgDE = "Ich würde es bevorzugen, wenn ihr mich nicht anfasst!"
useMsgUS = "Ich would prefer, that you don't touch me!!"


queststatus(2111) = 1, german, "[bb]ring.+[bb]ei.*", "[mm]ehr.*", "[tt]each.*", "[mm]ore.*" -> "Über welche der fünf Schulen wollt ihr mehr erfahren?", queststatus(2111) = 2
queststatus(2111) = 1, english, "[bb]ring.+[bb]ei.*", "[mm]ehr.*", "[tt]each.*", "[mm]ore.*" -> "Which school do you want to know more about?", queststatus(2111) = 2
queststatus(2111) = 3, german, "[bb]ring.+[bb]ei.*", "[mm]ehr.*", "[tt]each.*", "[mm]ore.*" -> "Ich hab euch bereits etwas beigebracht, den Rest müsst ihr euch selber beibringen wenn ihr ein richtiger Magier werden wollt."
queststatus(2111) = 3, english, "[bb]ring.+[bb]ei.*", "[mm]ehr.*", "[tt]each.*", "[mm]ore.*" -> "I taught you already something, you have to learn the rest by yourself if you want to become a real mage."
queststatus(2111) = 2, skill("commotio") <= 10, german, "commotio" -> "In Ordnung, hört mir nun bitte genau zu...", inform("Es scheint als wären dir nun einige Grundlagen dieser Runenschule klarer."), skill("commotio") + 1, queststatus(2111) = 3
queststatus(2111) = 2, skill("commotio") <= 10, english, "commotio" -> "Alright, please listen to me carefully now...", inform("It seems that you understand some basics of this school of rune now better."), skill("commotio") + 1, queststatus(2111) = 3
queststatus(2111) = 2, skill("commotio") > 10, german, "commotio" -> "Ihr scheint die Grundlagen dieser Runenschule bereits zu kennen, mehr als das kann ich euch nicht beibringen."
queststatus(2111) = 2, skill("commotio") > 10, english, "commotio" -> "You already seem to know the basics of this runeschool, I can't teach you more than that."
