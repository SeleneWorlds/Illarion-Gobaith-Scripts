use: german -> "Finger weg!"
use: english -> "Don't you touch me!"

cycle: pick(
    if(german, "#me blättert in einem Buch herum", "#me browses through a book"),
    if(german, "#me gähnt verhalten", "#me yawns restrained"),
)

chat: match(
    "hello",
    "greetings",
    "hi"
) -> "Greetings. Nice to meet you."

chat: match("who") -> "I am Eltareon"

chat: match(
    "bye.",
    "farewell"
) -> pick(
    "Be well",
    "Farewell"
)

chat: match(
    "hallo",
    "grü[ßs]+"
) -> "Grüße. Freut mich euch zu treffen."

chat: match("wer") -> "Ich bin Eltareon."

chat: match(
    "auf.+bald",
    "bis.+bald"
) -> pick(
    "Bis Bald",
    "Auf bald",
    "Auf balde"
)
