"[gg]reetings" -> "Greebas! You want buy from great %NPCNAME?"
"[hh]ello" -> "Hullo! Buy me things!"
"[yy]ou.+[tt]rader" -> "Yub, me trader."
"[ww]hat.+sell" -> "Me sell many shiny things, har har!"
"[ww]hat.+[ss]hiny.+things" -> "Gems 'n stuff."
"[tt]ell.+[ss]omething" -> "Nhub, you buy or go away!"
"[gg]oodbye" -> "Hurr!"
"[bb]ye" -> "Buy Buy!"
"[ff]arewell" -> "Fareeba!"
"[ww]hat.+buy" -> "Lots! Things wit' fight, armor, herbs, clothes 'n eating stuff!"
"[ww]ho.+you?" -> "I'm strong and great %NPCNAME!"
"i'm.+.+" -> "Me not interested. You buy or go 'way!"
"[hh]elp" -> "'List your wares', 'I want to buy <number> <wares>', 'I want to buy a <ware>', 'I want to sell <number|a> <wares>', 'Price of ...','What do you pay for ...', 'What wares do you buy?'"
"[gg]rü[ßs]e" -> "Greebas! Will kaufen von %NPCNAME?"
"[gg]rüsse" -> "Hullo! Du kaufen Zeug!"
"[hh]allo" -> "#me grunzt"
"[dd]u.+[hh]ändler" -> "Yubba! Du will kaufen?"
"[ww]as.+verkauf" -> "Mir verkaufen alles was glänzt!"
"[ee]rzähl.+[ee]twas" -> "Kein' Lust! Kauf, oder geh weg!"
"[aa]uf.+[bb]ald" -> "Hurr!"
"[bb]is.+[bb]ald" -> "Fareeba!"
"[ww]as.+%s[kk]auf" -> "Har Har! Ich kauf' Krieg Zeugs, Kleidung, Essen und Kräuters!"
"[ww]er.+du?" -> "Ich bin starker %NPCNAME!"
"ich.+bin.+.+" -> "Mir nix interessiert! Du kaufen, oder du gehen weg!"
