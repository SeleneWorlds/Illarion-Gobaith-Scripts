-- Derived from old/karkish_orcguard.lua; UTF-8.
-- Archived Lua remains the reference for custom behavior.
name = "Karkish Orcguard"
race = orc
sex = female
position = 159, -435, 0
direction = west
radius = 0
language = common
language = orc
defaultLanguage = common
autointroduce = on
useMsgDE = "Nimm Greifer deine weg, sonst du haben gleich keine mehr!"
useMsgUS = "Nub touch meh, stoopid!"


lua("npc.custom.orc_gate", "isCommand", "karkish_orcguard"), ".+" -> lua("npc.custom.orc_gate", "operate", "karkish_orcguard")

"[gg]rü[sß]", "[hh]allo", "[gg]rue[sß]", "[tt]a[gc].*" -> "Ullo.", "Grubas!"
"[aa]uf.+[bb]ald", "[gg]ötter.+euch", "[bb]is.+[bb]ald", "[aa]uf.+[bb]ald", "[ff]ünf.+euch" -> "Farebas."
"[ww]er.+[bs][ie][si][td].+[di][uh].*", "[ww]ie.+[nn]ame" -> "Mir Wache sein für Orktor! Keine Ratte hier rein kommen ohne dass %NPCNAME merken!"
"[hh]ilfe" -> "%NPCNAME dir nur kann öffnen Tor! Muss bewachen Tor! Frag anderen Bruder oder Schwester für andere Sachen!"
"[ww]as.+[mm]ach.*t" -> "%NPCNAME öffnen und schließen Orktor! Du wollen rein oder raus? Dann du mir sagen Losungswort!"
"[ll]osung.*[ww]ort" -> "#me grunzt verärgert 'Du denken %NPCNAME Maden im Kopf haben? Ich dir nicht sagen Wort! Mir nur hören auf Brüder und Schwester, die wissen Wort!'"
"[hh]eilig.*[bb]erg" -> "Dies hier sein Heiliger Berg, yubba! Heiliger Berg von 'Vater'!"
"[gg]reeting", "[hh]ello", "gr.*eebs", "gr.*eebas" -> "Greebas!", "Greebs"
"[gg]oodbye", "[bb]ye", "[ff]ar.*e.*well", "[ff]ar.*ebas", "[ff]ive.+you", "[ff]ive.+yoo" -> "Farrebas!", "Goodbyes."
"[ww]ho.+yo.+" -> "Meh beh %NPCNAME, nub single rat whub enterr orc caves witout meh sees it!"
"[ww]hat.+[nn]ame" -> "Meh %NPCNAME! Meh strong guard ob orc caves!"
"[ww]hub.+[nn]ame" -> "Meh %NPCNAME! Meh strong guard ob orc caves!"
"[hh]elp" -> "%NPCNAME nub can help yoo muchs! Ask ottur bruddah or sistah! Meh busy beh guardin...hurr, yoo hab seen rat running dere?!"
"[ww]hat.+[yy]o.*do" -> "%NPCNAME opens and closes orc gate! Yoo wunt get in or out? Den tell meh keyword"
"[kk]ey.*[ww]ord", "[pp]as.*word" -> "Yoo tink %NPCNAME stoopid beh? Meh nub tell yoo keyword! Meh just open gate fer bruddahs and sistahs whoo know word!"
"[hh]oly.*[mm]ountain" -> "Yubba, dis beh holy mountain ob 'father'! Orcs libe here since ancient times!"
"buy" -> "Tanks, meh hab eberytin' meh need."
"sell" -> "Meh nub sell anyting! Meh looks like merchant? Hurrr, nub!"
"[ww]hat.+buy" -> "Tanks, meh hab all meh need."
"[ww]hat.+sell" -> "Meh nub sell anyting! Meh do look like merchant? Hurrr, nub!"
"[vv]erkaufen" -> "Mir verkaufen nichts. %NPCNAME aussehen wie Händler?"
"[kk]aufen" -> "Danks, mir haben alles was Ork brauchen!"
"[ww]as.+verkaufst" -> "Mir verkaufen nichts. %NPCNAME aussehen wie Händler?"
"[ww]as.+kaufst" -> "Danks, mir haben alles was Ork brauchen!"
english, "[gg]obaith" -> "Tis whole island beh called Gobaith. Nice place, yubba! Good hunting grounds here beh near holy mountain!"
english, "[gg]obiath" -> "Tis whole island beh called Gobaith. Nice place, yubba! Good hunting grounds here beh near holy mountain!"
english, "[gg]reenbriar" -> "Greenbriar beh small settlement ob tiny and tasty Halflings. Albays good turr go dere fer snack. *he laughs*"
"[hh]arbo.*r" -> "Oomie town Troll's Bane and Vanima both hab harbors. The one southwest ob oomie town beh bigger though. Beddur nub go turr smelly elfie island!"
english, "[hh]ellbriar" -> "Hellbriar wus place ob sum servants ob our 'father' in past. Buts dere nub any orcs beh in dis Cult anymor', so father left dem alone and dey all got smashed, dey say."
"[mm]agic.+[aa]cademy" -> "Yoo nub wunt go dere! Smelly mages beh dere. Dey nub honorable warriors beh but cowards! Dey whub burrrn yoo... ib yoo lucky beh!"
"[mm]age.+[aa]cademy" -> "Yoo nub wunt go dere! Smelly mages beh dere. Dey nub honorable warriors beh but cowards! Dey whub burn yoo... ib yoo lucky beh!"
"[nn]orthmark" -> "Dey lib on ottur side ob island far in west. Dey hab strrong warriors meh hab heard! And best beh dat dey nub like magic neithurrr - jus' bit like orcs, hurrr."
"[ss]ilverbrand" -> "Dis beh stumpie town. Dey hab best smithes on isle, still dey beh hairy stumpies. Meh whub tink twice befor' going into deir halls!"
english, "[vv]anima" -> "Tol Vanima ? Dis beh island full ob flowers, trees and elfies. Beddur avoid going dere! Dey nub like visitors!"
english, "[tt]roll['s].*[bb]ane" -> "Oomie town Troll's Bane beh biggest town on Gobaith. Though, orcs usually get in trouble in dere! Beh careful when passing town gates!"
english, "[vv]arshikar" -> "Desert town Varshikar nub beh far abay from here, just short walk to southeast! Orcs hab peace wit dem! Treat dem fair and dey whub treat yoo fair toos! But beh careful ob mages in desert town!"
"[dd]esert.*town" -> "Desert town Varshikar nub beh far abay from here, just short walk to southeast! Orcs hab peace wit dem! Treat dem fair and dey whub treat yoo fair toos! But beh careful ob mages in desert town!"
english, "[ff]ather" -> "Yoo nub know father ob orcs? *he snorts* Yoo should talk turr Chief den! He whub make yoo rememburr 'fathurr' fer yoos whole life!"
german, "[vv]ater" -> "Du Vater von Orks nicht kennen? *schnaubt* Du dann mit Häuptling reden sollen! Er dich Vater für ganzes Leben erinnern lassen!"
english, "[kk]rull." -> "Krull beh great chief ob Orc Nation! Praise hims and praise fathurr!"
german, "[kk]rull." -> "Krull starker Häuptling von Ork Nation sein! Ehre ihm und Vater!"
english, "[rr]ugh.*" -> "Rugh... yoo talkin' bout Rugh'toh? he beh da former great chief ob Orcs ob Dar'krest!"
german, "[rr]ugh.*" -> "Rugh... du meinen Rugh'toh? Er früher großer Häuptling von Orks von Dar'krest sein!"
english, "[rr]ukka" -> "Rukka beh strong sistah! She beh smart and looks nicy like roasted halfy."
german, "[rr]ukka" -> "Rukka starke Schwester sein! Sie klug sein und schön wie gebratener Halbling aussehen."
english, "[oo]rgis" -> "Orgis'Ug good brothurr beh! He beh good friend ob mine!"
german, "[oo]rgis" -> "Orgis'Ug guter Bruder sein! Er guter Freund von mir sein!"
english, "[rr]ok.*[kk]re.*[hh]o" -> "Rok beh strong and wise bruddah! He beh clan leader ob Skullcrushers!"
german, "[rr]ok.*[kk]re.*[hh]o" -> "Rok starker und weiser Bruder sein! Er Anführer von Skullcrushers sein!"
english, "[gg]re.*la" -> "Gre'la beh da most beautiful orcess meh hab ebbur seen - unfortunately she hab left da caves lon' time ago."
german, "[gg]re.*la" -> "Gre'la schönste Orkfrau sein, die mir je gesehen haben. Leider sie Höhlen vor langer Zeit verlassen haben."
english, "[oo]live" -> "She beh oomie orc - half oomie, half orc. Buts meh nebbur hab trusted hers muchs. Meh nub understand why Chief Rugh does!"
german, "[oo]live" -> "Sie Menschork sein, halb Mensch, halb Ork. Aber mir ihr nie viel vertraut haben. Mir nicht verstehen, warum Häuptling Rugh ihr vertrauen!"
english, "[hh].+['][gg]reu" -> "Da best smith ob orcs ob Dark'Krest beh Hu'greu! He makes sharrpest blades and thickest armorrs! Meh tinks is hands hab been blessed by fathurr!"
german, "[hh].+['][gg]reu" -> "Bester Schmied von Orks von Dar'krest Hu'greu sein! Er schärfste Klingen und dickste Rüstungen machen! Mir denken, Vater seine Hände gesegnet haben!"
english, "[bb]rad.*ok.*" -> "Braddokk nub beh muchs around, buts he good bruddah beh anybay!"
german, "[bb]rad.*ok.*" -> "Braddokk nicht oft hier sein, aber trotzdem guter Bruder sein!"
english, "[rr]etlak" -> "Retlak once hab been da most honorable and strongest orc in isle. Den he hab gone mad and hang around wit too many oomies - nows he dead beh. Beddur dead orc, den flower orcs alive meh albays say."
german, "[rr]etlak" -> "Retlak einst stärkster und ehrenhaftester Ork auf Insel sein. Dann er verrückt geworden und zu viel mit Menschen herumhängen. Jetzt er tot sein. Besser toter Ork als lebender Blumenork, mir immer sagen."
english, "[gg]riv.*jak" -> "Grivijak once wus Chief ob orcs. He wus stong, yubba he wus! Buts den he hab left da isle - coward ib yoo askin meh!"
german, "[gg]riv.*jak" -> "Grivijak einst Häuptling von Orks sein. Er stark sein, yubba! Aber dann er Insel verlassen. Feigling, wenn du mir fragen!"
english, "[gg]abon" -> "Hurrr, meh only hab heard stories about mighty bruddah Gabon! He must hab been grrreat orc! Eben beddur den Chief we hab nows."
german, "[gg]abon" -> "Hurrr, mir nur Geschichten über mächtigen Bruder Gabon gehört haben! Er großer Ork gewesen sein! Sogar besser als jetziger Häuptling."
english, "[mm]urgo" -> "Harr, harrrr! Murrrgo - dis beh name ob da most flowery flower orc ob isle! Meh tinks he eben fears bees!"
german, "[mm]urgo" -> "Harr, harrr! Murgo Name von blumigstem Blumenork auf Insel sein! Mir denken, er sogar Bienen fürchten!"
english, "[kk]ar.*kish" -> "#me hits her own chest with her fist '%NPCNAME, dis beh meh, yubba!'"
german, "[kk]ar.*kish" -> "#me schlägt mit der Faust auf ihre Brust. '%NPCNAME, das mir sein, yubba!'"
english, "[gg]ruknug" -> "Yoo talking 'bout mehs bruddah, Gruknug? He beh upstairs, guarding da othur gate!"
german, "[gg]ruknug" -> "Du von Bruder Gruknug reden? Er oben sein und anderes Tor bewachen!"
english, "[cc]hief" -> "Hurr, Chief ob orcs beh mighty bruddah Krull! Rememburr his name! He hab done muchs fer orcs, fer our clan!"
german, "[hh]äuptling" -> "Hurr, Häuptling von Orks mächtiger Bruder Krull sein! Du Namen merken! Er viel für Orks und Clan getan haben!"
english, "[tt]urga" -> "Hurrr, Mighty bruddah Turga! He is grrreat orc! Eben beddur den Chief we hab nows."
german, "[tt]urga" -> "Hurrr, mächtiger Bruder Turga! Er großer Ork sein! Sogar besser als jetziger Häuptling."
english, "[cc]lan" -> "Yubba, dis beh caves ob strong orc clan! Tell meh clan name and meh whub open gate fer yoo!"
german, "[cc]lan" -> "Yubba, dies Höhlen von starkem Orkclan sein! Sag mir Namen von Clan und mir Tor für dich öffnen!"
"[dd]eser.*t" -> "#me snorts 'Da desert ob Kumdah beh in south ob orc lands! Oomies and scorpies beh all yoo whub find dere. Some rich mines beh dere after all.'"
"[ww][üue]ste" -> "#me schnaubt 'Wüste Kumdah in Süden sein von Orkland! Menschen und Skorpione sein alles du finden da! Die Berge immerhin haben reiche Schätze.'"
"or.*c.*" -> "#me hits his chest with his right fist and grunts 'Hurrr, Orcs ob Dar'krest beh strrongest! Praise father and holy mountain!'"
"or.*k.*" -> "#me schlägt mit seiner rechten Faust auf seine Brust 'Hurrr, Orks von Dar'krest die stärksten sein! Ehre für unseren Vater und heiligen Berg!'"
"tor" -> "Du wollen dass mir machen Tor auf? Dann du mir sagen Losungswort!"
"gate" -> "Yoo wunt meh open da gate? Den tell meh da keyword!"
english, "moshran" -> "#me growls angrily and shouts at you 'Nub tell father's name! Dis whub brring shame on us! Call him father, hurrr... and now leave meh alone!'"
german, "moshran" -> "#me grunzt erzürnt auf und schreit dich an 'Nicht nennen Vater bei Namen! Bringt Schande über uns! Vater du ihn nennen, hurrr... und jetzt in Ruhe lassen du mich!'"
german, "[gg]obaith" -> "Insel genannt wird Gobaith. Gute Gegend für Orks! Gute Jagdgründe hier sind in Nähe von heiligem Berg!"
german, "[gg]obiath" -> "Ja, diese Insel genannt wird Gobaith. Gute Gegend für Orks! Gute Jagdgründe hier sind in Nähe von heiligem Berg!"
german, "[gg]reenbriar" -> "Greenbriar kleine Siedlung ist, bewohnt von klein und lecker Halblings. Immer gut da hin gehen für Leckerbissen. *er lacht grunzend auf*"
"[hh]afen" -> "Hafen sein im Süden von Menschenstadt Troll's Bane. Auch stinkende Elfeninsel haben Hafen. Aber Wasser nix für Orkse ist, hurr!"
german, "[hh]ellbriar" -> "Hellbriarkult war von Anhängern von unser 'Vater'! Aber alle Orks haben verlassen Kult! Nicht gut er mehr ist. Nur Unheil bringen über orks, wenn du mich fragen."
"[mm]agierakademie" -> "Du besser nicht gehen besuchen Magier! Sie keine Ehre haben und keinen Spaß verstehen. Sie dich gleich verbrennen oder verwandeln in Kröte mit bloßem Blick!"
"[nn]ordmark" -> "Die Nordmarkmänner gute Menschen sein! Wie Orks sie nicht mögen Magie! Auch Nordmarkfrauen mit Waffen umgeh'n könn'! Trotzdem sie stinkende Menschen bleiben!"
"[ss]ilberbrand" -> "Zwergenstadt groß und heiß sein. Schmelzofen laufen ganzen Tag und Hammerschläge erfüllen Hallen immer mit Lärm. Wenn nicht Zwerge wären da, schöner Ort es wäre."
german, "[vv]anima" -> "Hurr! Fern bleiben du von dieser stinkenden Elfeninsel! Nur Unheil auf Orks dort warten!"
german, "[tt]roll['s].*[bb]ane" -> "Menschenstadt in Mitte der Insel du fragen nach? Groß und hässlich sie sein! Orkse nicht gern gesehen dort! Nimm Waffen mit, wenn du in Stadt müssen!"
german, "[vv]arshikar" -> "Wüstenstadt nicht fern von hier. Meisten Wesen dort dumm und stinkig - aber Clanführer, Grrrypus, Ehre haben! Sei gut zu Wüstenvolk, dann sie gut zu Orks sind!"
"[ww]üstenstadt" -> "Wüstenstadt nicht fern von hier. Meisten Wesen dort dumm und stinkig - aber Clanführer, Grrrypus, Ehre haben! Sei gut zu Wüstenvolk, dann sie gut zu Orks sind!"
"[ww]uestenstadt" -> "Wüstenstadt nicht fern von hier. Meisten Wesen dort dumm und stinkig - aber Clanführer, Grrrypus, Ehre haben! Sei gut zu Wüstenvolk, dann sie gut zu Orks sind!"

-- Idle dialogue
cycletext "#me stiert mit seinen gelblich schimmernden Augen in die vom Plätschern des Baches erfüllte Höhle.", "#me stares with yellowish glimming eyes into the dark cave."
cycletext "#me kratzt sich am kahlen Kopf", "#me scratches his pale head."
cycletext "#me wirft dir einen aufmerksamen Blick zu, jede deiner Bewegungen für einige Augenblicke wahrnehmend.", "#me glances at you with attentive gaze, watching any single movement of you for a few moments."

-- Migration follow-up
-- Legacy gate commands from up to eight tiles away require a dialogue-range extension.
