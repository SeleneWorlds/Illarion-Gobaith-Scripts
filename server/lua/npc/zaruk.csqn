use: german -> "Fast mich nicht an!"
use: english -> "Don't you touch me!"

chat: match(
    "hello",
    "greetings"
) -> pick(
    "Greetin's.",
    "Aye! Greetins to ye'."
)

chat: match("job") -> "I'm an importer, and I pull in wares from far and wide. Puts the jingle in me purse."
chat: match("imported") -> "Aye, imported wares, from the mainland to right here. See all the ships? Well, it's a quiet day today. Aye?"
chat: match("wares") -> "I have all sorts of gimcracks that ye'll surely be interested in. You seen my list?", showTrades("zaruk")
chat: match("ship") -> "Aye! I once sailed across the seas. Hard work. Not enough coin."

chat: match(
    "bye",
    "farewell"
) -> pick(
    "Aye! Farewell there.",
    "'Ave a pleasant day, there!"
)

chat: match("help") -> "'List your wares', 'I want to buy <number> <wares>', 'I want to buy a <ware>', 'I want to sell <number|a> <wares>', 'Price of ...','What do you pay for ...', 'What wares do you buy?'"

chat: match(
    "hallo",
    "grü[ßs]+e"
) -> pick(
    "Moin",
    "Aye. Grüß euch."
)

chat: match("beruf") -> "Ich bin ein Importierer und bekomm Waren von weit, weit weg."
chat: match("importiert") -> "Aye, importiere Waren, vom Festland direkt hier her. Siehst all die Schiffe. Nuja, ist ein ruhiger Tag heute, aye?"
chat: match("ware") -> "Ich hab alle Arten von Zeug die dich garantiert interessieren. Willst meine Warenliste sehen?", showTrades("zaruk")
chat: match("schiff") -> "Aye! Bin lange zur See gefahren. Harte Arbeit und beschissene Bezahlung."

chat: match(
    "auf.+bald",
    "bis.+bald"
) -> pick(
    "Aye. Auf bald.",
    "Aye. Schön Tag noch."
)

chat: match("hilfe") -> "'Welche Waren verkauft ihr', 'Ich möchte <Anzahl> <Ware> kaufen', 'Ich möchte <Ware> kaufen', 'Ich möchte <Anzahl> <Ware> verkaufen', 'Was ist der Preis von <Ware>','Was zahlt ihr für <Ware>', 'Was kauft ihr?'"

chat: chatTrading("zaruk")
